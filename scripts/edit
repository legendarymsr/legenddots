#!/usr/bin/env bash
# edit — open whichever editor you've picked as your default (neovim or emacs).
# This is what $EDITOR / $VISUAL point at, so git, doas -e, etc. all honour the
# choice. Switch the default any time with `use-nvim` / `use-emacs` (zsh funcs
# that write the pref file below). Default is neovim.
#
# Both editors share the same feel: neovim natively, emacs via evil-mode + a SPC
# leader — so the muscle memory carries across whichever one opens.
# Per-user choice wins; else the system default (/etc/legend/editor); else nvim.
pref="${XDG_CONFIG_HOME:-$HOME/.config}/legend/editor"
choice="$(cat "$pref" 2>/dev/null || cat /etc/legend/editor 2>/dev/null || echo nvim)"
case "$choice" in
  emacs)
    # Terminal emacs through the daemon; -a '' auto-starts a daemon if none runs.
    exec emacsclient -t -a '' "$@" ;;
  *)
    exec nvim "$@" ;;
esac
