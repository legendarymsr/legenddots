#!/usr/bin/env bash
# =============================================================================
# fix-waydroid-net — get the internet working inside Waydroid, and self-diagnose.
# Applies every routing/DNS fix, restarts the container, then runs the ping tests
# FROM INSIDE Android and reports exactly where (if anywhere) it still breaks.
#   doas bash fix-waydroid-net
# =============================================================================
set -o pipefail
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
hdr()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}!${NC} $*"; }
info() { echo -e "  ${CYAN}·${NC} $*"; }
die()  { echo -e "  ${RED}✗${NC} $*"; exit 1; }
[[ $EUID -eq 0 ]] || die "run as root:  doas bash fix-waydroid-net"
command -v waydroid >/dev/null 2>&1 || die "waydroid not installed."

WD_NET="192.168.240.0/24"
DNS1="${DNS1:-1.1.1.1}"; DNS2="${DNS2:-9.9.9.9}"

# 1. routing: ip_forward + NAT + forward accept (idempotent).
hdr "Host routing"
sysctl -w net.ipv4.ip_forward=1 >/dev/null; echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-waydroid.conf
ok "ip_forward on (persisted)"
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -C POSTROUTING -s "$WD_NET" ! -o waydroid0 -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$WD_NET" ! -o waydroid0 -j MASQUERADE
  iptables -C FORWARD -i waydroid0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i waydroid0 -j ACCEPT
  iptables -C FORWARD -o waydroid0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -o waydroid0 -j ACCEPT
  ok "NAT + FORWARD rules for $WD_NET"
fi

# 2. clean restart so waydroid re-runs its bridge + dnsmasq setup.
hdr "Restarting the container"
waydroid session stop 2>/dev/null || true
rc-service waydroid-container stop 2>/dev/null || systemctl stop waydroid-container 2>/dev/null || waydroid container stop 2>/dev/null || true
sleep 2
rc-service waydroid-container start 2>/dev/null || systemctl start waydroid-container 2>/dev/null || ( setsid waydroid container start >/dev/null 2>&1 & )
# wait for the container to actually be up
for _ in $(seq 1 10); do pgrep -f 'waydroid.*container' >/dev/null 2>&1 && break; sleep 1; done
sleep 3
ip -br addr show waydroid0 2>/dev/null | grep -q UP && ok "waydroid0 bridge up ($(ip -4 -br addr show waydroid0 2>/dev/null | awk '{print $3}'))" \
  || warn "waydroid0 bridge is down — container may not be running."
pgrep -f 'dnsmasq.*waydroid0' >/dev/null 2>&1 && ok "dnsmasq (container DNS) running" || warn "dnsmasq for waydroid0 not running — that alone breaks DNS."

# 3. force the container's DNS to a public resolver (the 'unknown host' fix).
hdr "Container DNS"
wsh() { waydroid shell -- "$@" 2>/dev/null; }
if wsh true; then
  # 'ndc resolver setnetdns' is removed on modern Android (500 Command not
  # recognized). Use Private DNS (DNS-over-TLS) instead — clean, persists across
  # sessions, and doesn't depend on the container's dnsmasq forwarder at all.
  # one.one.one.one = Cloudflare 1.1.1.1. (Needs routing to reach :853 — if this
  # doesn't help, the problem is routing, not DNS.)
  wsh settings put global private_dns_mode hostname
  wsh settings put global private_dns_specifier one.one.one.one
  wsh setprop net.dns1 "$DNS1"; wsh setprop net.dns2 "$DNS2"   # legacy fallback
  ok "set Private DNS -> one.one.one.one (Cloudflare DoT) + net.dns fallback"
else
  warn "couldn't 'waydroid shell' — is the container running (session up)? DNS not set."
fi

# 4. self-test FROM INSIDE Android — this is the definitive diagnosis.
hdr "Testing from inside Android"
t() { wsh ping -c1 -W2 "$1" >/dev/null 2>&1 && { ok "ping $1 — OK"; return 0; } || { warn "ping $1 — FAIL"; return 1; }; }
GW=ok; IP=ok; NM=ok
t 192.168.240.1 || GW=fail
t 1.1.1.1        || IP=fail
t gentoo.org     || NM=fail

hdr "Verdict"
if [[ "$GW" == ok && "$IP" == ok && "$NM" == ok ]]; then
  ok "Internet works inside Waydroid. 🎉  Reopen your apps."
elif [[ "$GW" == fail ]]; then
  warn "Can't even reach the gateway → the container isn't networked. It's probably"
  warn "not fully running: start the session once (waydroid session start &) then re-run."
elif [[ "$IP" == fail ]]; then
  warn "Gateway OK but no route to the internet → NAT/forwarding. If you run a firewall"
  warn "(nft), it's dropping forwarded packets; otherwise check the host's own uplink."
elif [[ "$NM" == fail ]]; then
  warn "Routing works, only DNS fails. The net.dns props are set above — fully restart"
  warn "the session (waydroid session stop; waydroid session start &) and retest. If it"
  warn "persists, your host /etc/resolv.conf may point at a dead stub (127.0.0.53)."
fi
