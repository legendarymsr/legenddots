pkg zsh_f     "$SRC/zsh-5.9.tar.xz"           bash -c "./configure --prefix=/usr --sysconfdir=/etc/zsh --enable-multibyte --enable-pcre --enable-cap; make \$MAKEFLAGS; make install; echo '/usr/bin/zsh' >> /etc/shells"
pkg cmake_f   "$SRC/cmake-3.30.2.tar.gz"      bash -c "./configure --prefix=/usr --parallel=3 -- -DCMAKE_USE_OPENSSL=ON; make \$MAKEFLAGS; make install"
pkg doas_f    "$SRC/opendoas-6.8.2.tar.gz"    bash -c "./configure --prefix=/usr --sysconfdir=/etc --with-timestamp; make \$MAKEFLAGS; make install"

echo "==> LFS chroot build complete."
CHROOT

chmod +x "$LFS/tmp/lfs-chroot.sh"

if ! step_done chroot_build; then
  header "Phase 3 — base system in chroot"
  source /var/log/lfs-parts.env
  chroot "$LFS" /usr/bin/env -i \
    HOME=/root TERM="$TERM" PS1='(lfs) \u:\w\$ ' \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    MAKEFLAGS="$MAKEFLAGS" \
    ROOT="$ROOT" EFI="$EFI" SWAP="$SWAP" \
    /bin/bash /tmp/lfs-chroot.sh
  mark_step chroot_build
fi

# ── rEFInd ───────────────────────────────────────────────────────────────────
if ! step_done refind; then
  header "Installing rEFInd"
  if ! command -v refind-install &>/dev/null; then
    warn "refind-install not found on host — install sys-boot/refind on Gentoo first"
    warn "  emerge sys-boot/refind"
    warn "Re-run this script after installing rEFInd to complete the bootloader step."
  else
    source /var/log/lfs-parts.env
    ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
    refind-install --usedefault "$EFI" --root "$LFS"
    cat > "$LFS/boot/efi/EFI/BOOT/refind_linux.conf" << EOF
"GNU/Linux-libre" "ro root=UUID=${ROOT_UUID} quiet"
EOF
    mark_step refind
  fi
fi

# ── Mark base complete and unmount ────────────────────────────────────────────
mkdir -p "$LFS/etc"
grep -qx "lfs_complete" "$LFS/etc/libre-setup.state" 2>/dev/null || \
  echo "lfs_complete" >> "$LFS/etc/libre-setup.state"

header "Unmounting $LFS"
umount -R "$LFS/dev" "$LFS/proc" "$LFS/sys" "$LFS/run" 2>/dev/null || true
umount "$LFS/boot/efi" 2>/dev/null || true
umount "$LFS"          2>/dev/null || true

echo -e "\n${GREEN}── GNU/Linux-libre base system complete ──${NC}"
echo "1. Boot from $LFS_DISK (select GNU/Linux-libre in rEFInd)"
echo "2. Log in as root (password: legendary123)"
echo "3. Clone legenddots and rerun this script to build the desktop:"
echo "   git clone https://github.com/legendarymsr/legenddots ~/legenddots"
echo "   bash ~/legenddots/libre/setup"
echo ""
echo "The system boots GNU Shepherd as PID 1 (init=/sbin/init → shepherd)."
echo "Everything is 100% free software — no nonfree firmware, no blobs."
exit 0

fi  # end LFS_DONE==false

# =============================================================================
# PHASE 2 — BLFS DESKTOP (runs inside LFS)
# =============================================================================

STATE_FILE=/etc/libre-setup.state
touch "$STATE_FILE"
step_done() { grep -qx "$1" "$STATE_FILE"; }
mark_step()  { echo "$1" >> "$STATE_FILE"; }

SOURCES=/sources
mkdir -p "$SOURCES"

export CC="gcc"
export CXX="g++"
export CFLAGS="-march=x86-64 -O2 -pipe"
export CXXFLAGS="-march=x86-64 -O2 -pipe"
export MAKEFLAGS="-j2"
export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig"
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin"

NPROC=2

fetch() {
  local url="$1"
  local out="$SOURCES/$(basename "$url")"
  if [[ ! -f "$out" ]]; then
    info "Fetching $(basename "$url")..."
    wget -q --show-progress -c -O "$out" "$url" || { rm -f "$out"; die "Download failed: $url"; }
  fi
  echo "$out"
}

bpkg() {
  local archive="$1"; shift
  local bdir; bdir=$(mktemp -d "$SOURCES/build.XXXXXX")
  tar -xf "$archive" -C "$bdir" --strip-components=1
  pushd "$bdir" >/dev/null
  "$@"
  local rc=$?
  popd >/dev/null
  rm -rf "$bdir"
  return $rc
}

