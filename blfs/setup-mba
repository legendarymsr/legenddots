"\eOc": forward-word
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[3~": delete-char
"\e[2~": quoted-insert
EOF2

  cat > /etc/shells << 'EOF2'
/bin/sh
/bin/bash
EOF2

  echo 'root:legendary123' | chpasswd
  mark sysconfig
