#!/usr/bin/env bash
# One-shot WiFi recovery + connect for the Broadcom wl driver on this MacBook Air.
# Run: doas bash ~/legenddots/gentoo/troubleshooting/fix-wifi
# Loads wl (evicting competing drivers), stops a stray dhcpcd that would grab the
# interface out from under NetworkManager, hands the device to NM, scans, and
# prompts you to connect. One command, no copy-pasting a chain of nmcli lines.
set -u

[[ $EUID -eq 0 ]] || { echo "run with doas: doas bash gentoo/troubleshooting/fix-wifi"; exit 1; }

echo "== evicting competing broadcom drivers (if any) =="
rmmod brcmfmac brcmsmac b43 bcma ssb 2>/dev/null || true

echo "== loading wl =="
if modprobe wl 2>&1; then
  echo ">>> wl loaded"
else
  echo ">>> wl FAILED to load — likely a symbol/vermagic mismatch after a kernel"
  echo "    rebuild. Rebuild the module against the running kernel:"
  echo "      doas emerge --usepkg=n @module-rebuild && doas depmod -a"
  echo "    (or boot vmlinuz.old at rEFInd — WiFi works there — and rebuild.)"
  exit 1
fi

WIFI=$(ls /sys/class/net 2>/dev/null | grep -E '^wl' | head -1)
[[ -n "$WIFI" ]] || { echo ">>> no wl* interface yet — check: doas dmesg | grep -i wl"; exit 1; }
echo "== wifi interface: $WIFI =="

# A stray dhcpcd (or netifrc net.*) holding the interface makes NetworkManager
# report it as 'connected (externally)' with a STALE ip and NO real association
# (NO-CARRIER) — so nothing routes and DNS fails. Hand WiFi to NM exclusively.
echo "== stopping conflicting network services (so NM owns WiFi) =="
rc-service dhcpcd stop 2>/dev/null || true
rc-service "net.$WIFI" stop 2>/dev/null || true
rc-update del dhcpcd default 2>/dev/null && echo "  (removed dhcpcd from boot — NM handles DHCP)" || true

echo "== restarting NetworkManager =="
rc-service NetworkManager restart
sleep 2
nmcli radio wifi on                     2>/dev/null || true
nmcli device set "$WIFI" managed yes     2>/dev/null || true
nmcli device disconnect "$WIFI"          2>/dev/null || true   # clear stale external state
sleep 1
nmcli device wifi rescan                 2>/dev/null || true
sleep 2

echo "== available networks =="
nmcli device wifi list 2>/dev/null || echo "  (scan failed — radio off? try: doas rfkill unblock all)"

echo
read -rp "Connect to which SSID? (blank to skip) " SSID
if [[ -n "${SSID:-}" ]]; then
  read -rsp "Password for \"$SSID\": " PASS; echo
  if nmcli device wifi connect "$SSID" password "$PASS"; then
    echo ">>> connected. Testing DNS:"
    ping -c2 gentoo.org
  else
    echo ">>> connect failed — check SSID/password and rerun, or: doas rfkill unblock all"
  fi
else
  echo "Skipped. Connect later with:"
  echo "  doas nmcli device wifi connect \"SSID\" password \"PASS\""
fi

echo
echo "== status =="
nmcli device status 2>/dev/null
ip route 2>/dev/null | grep -q '^default' && echo ">>> default route present — you're online" \
  || echo ">>> no default route yet — not associated; rerun and pick your SSID"
