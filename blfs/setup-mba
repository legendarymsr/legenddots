# ── System configuration ───────────────────────────────────────────────────────
if ! stepdone sysconfig; then
  echo "==> System configuration"
  ROOT_UUID=$(blkid -s UUID -o value "$ROOT") || { echo "blkid failed for $ROOT"; exit 1; }
  EFI_UUID=$(blkid -s UUID -o value "$EFI")   || { echo "blkid failed for $EFI"; exit 1; }
  {
    echo "UUID=$ROOT_UUID  /          ext4   defaults,noatime       0 1"
    echo "UUID=$EFI_UUID   /boot/efi  vfat   umask=0077             0 2"
    if [ -n "${SWAP:-}" ]; then
      SWAP_UUID=$(blkid -s UUID -o value "$SWAP") || { echo "blkid failed for $SWAP"; exit 1; }
      echo "UUID=$SWAP_UUID  none       swap   sw                    0 0"
    else
      dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
      chmod 600 /swapfile
      mkswap /swapfile > /dev/null
      echo "/swapfile  none  swap  sw  0 0"
    fi
    echo "tmpfs  /tmp  tmpfs  defaults,nosuid,nodev  0 0"
  } > /etc/fstab

  echo "lfs" > /etc/hostname
  echo "12.4" > /etc/lfs-release

  cat > /etc/inittab << 'EOF2'
id:3:initdefault:

si::sysinit:/etc/rc.d/init.d/rc S

l0:0:wait:/etc/rc.d/init.d/rc 0
l1:S1:wait:/etc/rc.d/init.d/rc 1
l2:2:wait:/etc/rc.d/init.d/rc 2
l3:3:wait:/etc/rc.d/init.d/rc 3
l4:4:wait:/etc/rc.d/init.d/rc 4
l5:5:wait:/etc/rc.d/init.d/rc 5
l6:6:wait:/etc/rc.d/init.d/rc 6

ca:12345:ctrlaltdel:/sbin/shutdown -t1 -a -r now

su:S06:once:/sbin/sulogin
s1:1:respawn:/sbin/sulogin

1:2345:respawn:/sbin/agetty --noclear tty1 9600
2:2345:respawn:/sbin/agetty tty2 9600
3:2345:respawn:/sbin/agetty tty3 9600
4:2345:respawn:/sbin/agetty tty4 9600
EOF2

  mkdir -pv /etc/sysconfig /etc/profile.d
  cat > /etc/sysconfig/clock << 'EOF2'
UTC=1
CLOCKPARAMS=
EOF2
  cat > /etc/sysconfig/console << 'EOF2'
