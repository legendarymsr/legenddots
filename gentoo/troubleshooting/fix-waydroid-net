#!/usr/bin/env bash
# =============================================================================
# fix-waydroid-net — one command to get Waydroid's internet working.
# By default it does a CLEAN restart (container, and best-effort your session),
# then repairs the network in place — host ip_forward + NAT, the waydroid0 bridge
# gateway IP, and the container's eth0 IP + default route + DNS — and tests from
# inside Android. Idempotent; rerun any time. The repair fills in a static IP +
# route when Waydroid's DHCP doesn't, so it recovers even a fully dead container.
#   doas bash fix-waydroid-net                # restart + repair (default)
#   doas bash fix-waydroid-net --no-restart   # repair the running container in place
# =============================================================================
set -o pipefail
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
hdr()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}!${NC} $*"; }
info() { echo -e "  ${CYAN}·${NC} $*"; }
die()  { echo -e "  ${RED}✗${NC} $*"; exit 1; }
[[ $EUID -eq 0 ]] || die "run as root:  doas bash fix-waydroid-net"
command -v waydroid >/dev/null 2>&1 || die "waydroid not installed."

WD_NET=192.168.240.0/24; GW=192.168.240.1; GW_CIDR=192.168.240.1/24
CONT_IP="${CONT_IP:-192.168.240.112/24}"   # static fallback if DHCP gave eth0 no IP
DNS1="${DNS1:-1.1.1.1}"; DNS2="${DNS2:-1.0.0.1}"
RESTART=1; [[ "${1:-}" == "--no-restart" ]] && RESTART=0   # default: auto-restart
wsh() { waydroid shell -- "$@" 2>/dev/null; }

# Figure out the human user + their Wayland session, so we can (re)start the
# session as them (waydroid session start needs XDG_RUNTIME_DIR + WAYLAND_DISPLAY).
U="${DOAS_USER:-${SUDO_USER:-}}"; [[ -z "$U" ]] && U="$(logname 2>/dev/null || true)"
[[ -z "$U" || "$U" == root ]] && { id legend &>/dev/null && U=legend; }
UID_N="$(id -u "$U" 2>/dev/null || echo)"; XRD="/run/user/${UID_N}"
WLDISP="$(basename "$(find "$XRD" -maxdepth 1 -name 'wayland-[0-9]*' 2>/dev/null | grep -v '\.lock$' | head -1)" 2>/dev/null)"
as_user() { su - "$U" -c "export XDG_RUNTIME_DIR='$XRD' WAYLAND_DISPLAY='${WLDISP:-wayland-1}'; $*"; }

# 1. HOST: IPv4 forwarding + NAT + forward accept.
hdr "Host routing"
sysctl -w net.ipv4.ip_forward=1 >/dev/null
echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-waydroid.conf
ok "ip_forward on (persisted)"
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -C POSTROUTING -s "$WD_NET" ! -o waydroid0 -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$WD_NET" ! -o waydroid0 -j MASQUERADE
  iptables -C FORWARD -i waydroid0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i waydroid0 -j ACCEPT
  iptables -C FORWARD -o waydroid0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -o waydroid0 -j ACCEPT
  ok "NAT + FORWARD rules for $WD_NET"
else
  warn "iptables not found (emerge net-firewall/iptables)"
fi

# 1b. RESTART Waydroid cleanly (default; pass --no-restart to skip). Host routing
#     is already set above, so the fresh container comes up with forwarding ready.
if [[ "$RESTART" == 1 ]]; then
  hdr "Restarting Waydroid"
  as_user "waydroid session stop" >/dev/null 2>&1 || waydroid session stop >/dev/null 2>&1 || true
  rc-service waydroid-container stop >/dev/null 2>&1 || systemctl stop waydroid-container >/dev/null 2>&1 || waydroid container stop >/dev/null 2>&1 || true
  sleep 2
  ip link del waydroid0 2>/dev/null || true          # clear a stale bridge for a clean slate
  ( setsid waydroid container start >/dev/null 2>&1 & )
  for _ in $(seq 1 15); do ip link show waydroid0 >/dev/null 2>&1 && break; sleep 1; done
  sleep 2
  ip link show waydroid0 >/dev/null 2>&1 && ok "container manager restarted, bridge back" || warn "bridge didn't reappear yet"
  # start the session as the user so Android boots — best-effort (needs their Wayland).
  if [[ -n "$WLDISP" && -d "$XRD" ]]; then
    info "starting session as $U (display $WLDISP)…"
    as_user "setsid waydroid session start >/dev/null 2>&1 < /dev/null &" >/dev/null 2>&1 || warn "session auto-start failed"
    for _ in $(seq 1 25); do wsh true && break; sleep 1; done    # wait for Android to answer
  else
    warn "no Wayland session found for ${U:-?} — start it in niri yourself:  waydroid session start &"
  fi
fi

# 2. HOST BRIDGE: waydroid0 must exist (the container creates it) and carry the
#    gateway IP. Add it if it's missing.
hdr "Host bridge (waydroid0)"
if ip link show waydroid0 >/dev/null 2>&1; then
  ip link set waydroid0 up 2>/dev/null
  if ip -4 addr show waydroid0 2>/dev/null | grep -q "$GW"; then
    ok "waydroid0 up, has $GW"
  else
    ip addr add "$GW_CIDR" dev waydroid0 2>/dev/null && ok "added $GW to waydroid0" || warn "couldn't add $GW to waydroid0"
  fi
else
  warn "waydroid0 doesn't exist — the container isn't running yet."
  info "Start it first, then rerun me:  doas waydroid container start   (+ 'waydroid session start &' in niri)"
fi

# 3. CONTAINER: eth0 up, has an IP, has a default route, has DNS. All in place
#    without restarting anything.
hdr "Container network"
if wsh true; then
  wsh ip link set eth0 up
  if wsh ip addr show eth0 | grep -q '192\.168\.240'; then
    ok "eth0 has an IP ($(wsh ip -4 addr show eth0 | awk '/inet /{print $2; exit}'))"
  else
    wsh ip addr add "$CONT_IP" dev eth0 && ok "assigned $CONT_IP to eth0 (DHCP had given none)" \
      || warn "couldn't set eth0 IP"
  fi
  if wsh ip route show default | grep -q default; then
    ok "default route present"
  else
    wsh ip route add default via "$GW" dev eth0 && ok "added default route via $GW" \
      || warn "couldn't add default route (does eth0 have a 192.168.240.x IP above?)"
  fi
  # DNS: Private DNS (DoT) — modern, persists, bypasses the flaky dnsmasq forwarder.
  wsh settings put global private_dns_mode hostname
  wsh settings put global private_dns_specifier one.one.one.one
  wsh setprop net.dns1 "$DNS1"; wsh setprop net.dns2 "$DNS2"
  ok "DNS -> Private DNS one.one.one.one (Cloudflare) + net.dns fallback"
else
  warn "'waydroid shell' failed — the session isn't running."
  info "In niri:  waydroid session start &   then rerun me."
fi

# 4. TEST from inside Android + verdict.
hdr "Test (from inside Android)"
t() { wsh ping -c1 -W2 "$1" >/dev/null 2>&1 && { ok "ping $1 — OK"; return 0; } || { warn "ping $1 — FAIL"; return 1; }; }
G=ok; I=ok; N=ok
t "$GW" || G=fail
t 1.1.1.1 || I=fail
t fsf.org || N=fail
hdr "Verdict"
if [[ $G == ok && $I == ok && $N == ok ]]; then
  ok "Internet works inside Waydroid. 🎉  Reopen your apps."
elif [[ $G == fail ]]; then
  warn "Can't reach the gateway → the container network is down. Do ONE clean restart,"
  warn "then rerun me:  waydroid session stop; doas waydroid container stop; doas waydroid container start"
elif [[ $I == fail ]]; then
  warn "Gateway OK, no route to the internet → host NAT/uplink. Are you online on the host?"
else
  warn "Routing OK, DNS still resolving-fails → rerun me once more (Private DNS needs one"
  warn "lookup to bootstrap), or check the host's /etc/resolv.conf has a real nameserver."
fi
