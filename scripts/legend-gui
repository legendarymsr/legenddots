#!/usr/bin/env python3
"""LegendChrome — a lean, AMNESIC PyQt6 browser.

By design it remembers nothing: off-the-record profile (no history, no on-disk
cookies, no cache), all third-party cookies blocked, DNT + GPC sent, cookie
banners auto-rejected. Plus tabs, network ad-blocking, YouTube ad-skipping, and
qutebrowser-style keys: `f` to hint links, `.m` to send the page to mpv.

Deps:  pip install PyQt6 PyQt6-WebEngine   (and `mpv` for `.m`)
Run:   python legend-gui  [url]

Optional big blocklist: hosts-format file at ~/.config/legendchrome/blocklist.txt
(read only — no browsing data is ever written there).
"""
import sys
import os
import subprocess
from pathlib import Path

os.environ.setdefault(
    "QTWEBENGINE_CHROMIUM_FLAGS",
    "--blink-settings=forceDarkModeEnabled=true",
)

from PyQt6.QtCore import QUrl, QThread, pyqtSignal
from PyQt6.QtGui import QKeySequence, QShortcut
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QLineEdit, QVBoxLayout, QHBoxLayout, QWidget,
    QTabWidget, QPushButton,
)
from PyQt6.QtWebEngineCore import (
    QWebEngineUrlRequestInterceptor, QWebEngineProfile, QWebEngineScript,
    QWebEnginePage, QWebEngineSettings,
)
from PyQt6.QtWebEngineWidgets import QWebEngineView

CONFIG_DIR = Path.home() / ".config" / "legendchrome"
HOME_URL = "https://search.brave.com"
SEARCH_URL = "https://search.brave.com/search?q={}"
STEVENBLACK_URL = "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts"
BG, FG, ACCENT, DIM, GREEN = "#1a1b26", "#c0caf5", "#7aa2f7", "#414868", "#9ece6a"

# Default: a short, simple core of the worst ad/tracking domains.
SIMPLE_BLOCKLIST = {
    "doubleclick.net", "googleadservices.com", "google-analytics.com",
    "googlesyndication.com", "pagead2.googlesyndication.com", "googletagmanager.com",
    "googletagservices.com", "amazon-adsystem.com", "adnxs.com", "criteo.com",
    "taboola.com", "outbrain.com", "scorecardresearch.com", "adsrvr.org",
}

# Extra: analytics/telemetry + more ad networks. Merged in by the "Extend" button
# (along with a local ~/.config/legendchrome/blocklist.txt or StevenBlack's hosts).
EXTRA_BLOCKLIST = {
    "adservice.google.com", "criteo.net", "hotjar.com", "cookiebot.com",
    "onetrust.com", "cookielaw.org", "quantserve.com", "moatads.com",
    "rubiconproject.com", "pubmatic.com", "openx.net", "casalemedia.com",
    "bidswitch.net", "sharethrough.com", "smartadserver.com", "yieldmo.com",
    "mixpanel.com", "segment.com", "amplitude.com", "fullstory.com",
    "bugsnag.com", "sentry.io", "branch.io", "appsflyer.com", "adjust.com",
    "chartbeat.com", "newrelic.com", "nr-data.net", "clarity.ms",
}


def load_local_blocklist():
    """Domains from an optional user-provided hosts-format file (read-only)."""
    domains = set()
    f = CONFIG_DIR / "blocklist.txt"
    if f.exists():
        for line in f.read_text(errors="ignore").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            host = line.split()[-1]
            if host not in ("localhost", "0.0.0.0", "127.0.0.1"):
                domains.add(host)
    return domains


class FetchWorker(QThread):
    """Downloads StevenBlack's hosts in the background (kept in memory only)."""
    done = pyqtSignal(set)

    def run(self):
        import urllib.request
        domains = set()
        try:
            req = urllib.request.Request(STEVENBLACK_URL, headers={"User-Agent": "legendchrome"})
            data = urllib.request.urlopen(req, timeout=25).read().decode("utf-8", "ignore")
            for line in data.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line.split()
                if len(p) >= 2 and p[0] in ("0.0.0.0", "127.0.0.1"):
                    if p[1] not in ("localhost", "0.0.0.0", "127.0.0.1"):
                        domains.add(p[1])
        except Exception as e:  # network/DNS/etc — just report, stay usable
            print("blocklist fetch failed:", e)
        self.done.emit(domains)


class AdBlocker(QWebEngineUrlRequestInterceptor):
    def __init__(self, domains):
        super().__init__()
        self.domains = domains

    def interceptRequest(self, info):
        # Privacy signals on every request.
        info.setHttpHeader(b"DNT", b"1")
        info.setHttpHeader(b"Sec-GPC", b"1")
        host = info.requestUrl().host()
        if host:
            parts = host.split(".")
            for i in range(len(parts) - 1):
                if ".".join(parts[i:]) in self.domains:
                    info.block(True)
                    return
        if "facebook.com/tr" in info.requestUrl().toString():
            info.block(True)


# CSS/JS: fonts, hide ad + banner chrome, YouTube ad-skip, auto-reject consent.
SILENCER_JS = r"""
(function() {
    const css = document.createElement('style');
    css.innerText = `
      body,p,h1,h2,h3,span,div,a { font-family:'JetBrainsMono Nerd Font',monospace !important; }
      #cookie-banner,.cookie-banner,#onetrust-banner-sdk,.ot-sdk-container,.fc-ab-root,
      ytd-ad-slot-renderer,.ytp-ad-module,.video-ads,.ytp-ad-overlay-container,
      ytd-banner-promo-renderer-background,ytd-in-feed-ad-layout-renderer,
      #masthead-ad,.ytd-display-ad-renderer,#cookieConsent,.cc-window { display:none !important; }`;
    document.documentElement.appendChild(css);

    const rejects = ['#onetrust-reject-all-handler','.ot-pc-refuse-all-handler',
        '.fc-cta-do-not-consent','#reject-all','button[id*="reject" i]',
        'button[aria-label*="reject" i]','.cc-deny','[data-role="reject"]'];

    setInterval(() => {
        // YouTube ads
        const skip = document.querySelector(
          '.ytp-ad-skip-button,.ytp-ad-skip-button-modern,.videoAdUiSkipButton,.ytp-skip-ad-button');
        if (skip) skip.click();
        const vid = document.querySelector('video');
        if (vid && document.querySelector('.ad-showing,.ytp-ad-player-overlay')) {
            vid.playbackRate = 16.0; vid.muted = true;
        }
        const pop = document.querySelector('ytd-popup-container tp-yt-paper-dialog');
        if (pop) pop.remove();
        // Cookie/consent: click "reject all" wherever we can find it
        for (const s of rejects) { const b = document.querySelector(s); if (b) b.click(); }
    }, 500);
})();
"""

# qutebrowser-style keymap: `f` link hints, `.m` -> mpv. All in-page so it is
# focus-aware (typing in an input never triggers commands). mpv handoff goes to
# Python via a magic console.log the page class listens for.
KEYMAP_JS = r"""
(function() {
    if (window.__legendKeys) return; window.__legendKeys = true;
    const editable = el => el && (el.isContentEditable ||
        /^(input|textarea|select)$/i.test(el.tagName));
    let hinting = false, leader = false, buf = "", hints = {};

    function clear() {
        document.querySelectorAll('.__lh').forEach(e => e.remove());
        hinting = false; buf = ""; hints = {};
    }
    function labels(n) {
        const c = "asdfghjklqwertyuiop".split("");
        if (n <= c.length) return c.slice(0, n);
        const out = [];
        for (const a of c) for (const b of c) if (out.length < n) out.push(a + b);
        return out;
    }
    function hint() {
        clear();
        const els = [...document.querySelectorAll(
            'a[href],button,input[type=submit],input[type=button],[role=button],[onclick]')]
            .filter(el => { const r = el.getBoundingClientRect();
                return r.width > 0 && r.height > 0 && r.bottom > 0 &&
                       r.top < innerHeight && r.right > 0 && r.left < innerWidth; });
        if (!els.length) return;
        const labs = labels(els.length);
        els.forEach((el, i) => {
            const r = el.getBoundingClientRect();
            const t = document.createElement('span');
            t.className = '__lh'; t.textContent = labs[i];
            t.style.cssText = 'position:fixed;z-index:2147483647;left:' + r.left +
                'px;top:' + r.top + 'px;background:#7aa2f7;color:#1a1b26;' +
                'font:bold 11px monospace;padding:1px 4px;border-radius:3px;';
            document.body.appendChild(t);
            hints[labs[i]] = el;
        });
        hinting = true; buf = "";
    }
    function mpv() { console.log("LEGENDCMD:mpv:" + location.href); }

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey || e.altKey || e.metaKey) return;
        if (editable(document.activeElement) && !hinting) return;  // insert mode
        if (hinting) {
            if (e.key === 'Escape') { clear(); e.preventDefault(); return; }
            if (/^[a-z]$/.test(e.key)) {
                buf += e.key;
                if (hints[buf]) { const el = hints[buf]; clear(); el.focus(); el.click(); e.preventDefault(); return; }
                if (!Object.keys(hints).some(k => k.startsWith(buf))) buf = "";
                e.preventDefault();
            }
            return;
        }
        if (leader) { leader = false; if (e.key === 'm') { mpv(); e.preventDefault(); } return; }
        if (e.key === 'f') { hint(); e.preventDefault(); return; }
        if (e.key === '.') { leader = true; e.preventDefault(); return; }
    }, true);
})();
"""


class LegendPage(QWebEnginePage):
    """Page on the shared profile: opens new windows as tabs, handles the mpv
    handoff, and enables fullscreen."""
    def __init__(self, profile, window):
        super().__init__(profile, window)
        self.window = window
        s = self.settings()
        s.setAttribute(QWebEngineSettings.WebAttribute.FullScreenSupportEnabled, True)
        s.setAttribute(QWebEngineSettings.WebAttribute.JavascriptCanOpenWindows, True)
        s.setAttribute(QWebEngineSettings.WebAttribute.ScrollAnimatorEnabled, True)
        s.setAttribute(QWebEngineSettings.WebAttribute.PdfViewerEnabled, True)
        self.fullScreenRequested.connect(lambda req: (req.accept(),
            self.window.showNormal() if self.window.isFullScreen() else self.window.showFullScreen()))

    def createWindow(self, _type):
        return self.window.add_tab().page()

    def javaScriptConsoleMessage(self, level, msg, line, source):
        if msg.startswith("LEGENDCMD:mpv:"):
            url = msg[len("LEGENDCMD:mpv:"):]
            try:
                subprocess.Popen(["mpv", url])
                print(f"▶ mpv {url}")
            except FileNotFoundError:
                print("mpv not installed (pkg/emerge media-video/mpv)")
            return
        # otherwise swallow page console spam


class LegendChrome(QMainWindow):
    def __init__(self, start_url):
        super().__init__()
        self.setWindowTitle("LegendChrome // AMNESIAC")
        self.setGeometry(100, 100, 1280, 820)

        # AMNESIC: off-the-record profile (no name) → no history, no on-disk
        # cookies, no cache. Session cookies live in RAM and die on close.
        self.profile = QWebEngineProfile(self)
        self.profile.setHttpUserAgent(
            "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/126.0.0.0 Safari/537.36")
        # Simple by default — just the core list. The 🛡 button extends it.
        self.interceptor = AdBlocker(set(SIMPLE_BLOCKLIST))
        self._extended = False
        self.profile.setUrlRequestInterceptor(self.interceptor)
        # Block ALL third-party cookies (stronger than banner-hiding alone).
        self.profile.cookieStore().setCookieFilter(lambda req: not req.thirdParty)
        self.profile.downloadRequested.connect(self._on_download)
        self._install_scripts()

        self.url_bar = QLineEdit()
        self.url_bar.setPlaceholderText("Search Brave or enter URL…   (f = hint links · .m = mpv)")
        self.url_bar.returnPressed.connect(self.navigate)
        self.url_bar.setStyleSheet(f"""
            QLineEdit {{ background:{BG}; color:{FG}; border:none; padding:9px 12px;
                        font-family:'JetBrainsMono Nerd Font'; font-size:14px;
                        border-bottom:2px solid {ACCENT}; }}""")

        # Extend-blocklist button — simple list by default, click to go heavy.
        self.extend_btn = QPushButton("🛡")
        self.extend_btn.setToolTip("Extend blocklist (analytics/telemetry + StevenBlack hosts)")
        self.extend_btn.clicked.connect(self.extend_blocklist)
        self._style_btn(ACCENT)
        top_row = QHBoxLayout(); top_row.setContentsMargins(0, 0, 0, 0); top_row.setSpacing(0)
        top_row.addWidget(self.url_bar); top_row.addWidget(self.extend_btn)
        top_widget = QWidget(); top_widget.setLayout(top_row)

        self.tabs = QTabWidget()
        self.tabs.setDocumentMode(True)
        self.tabs.setTabsClosable(True)
        self.tabs.setMovable(True)
        self.tabs.tabCloseRequested.connect(self.close_tab)
        self.tabs.currentChanged.connect(self._tab_changed)
        self.tabs.setStyleSheet(f"""
            QTabWidget::pane {{ border:0; }}
            QTabBar::tab {{ background:{BG}; color:{FG}; padding:6px 14px; border:0;
                            font-family:'JetBrainsMono Nerd Font'; }}
            QTabBar::tab:selected {{ border-bottom:2px solid {ACCENT}; }}
            QTabBar::tab:!selected {{ color:{DIM}; }}""")

        layout = QVBoxLayout(); layout.setContentsMargins(0, 0, 0, 0); layout.setSpacing(0)
        layout.addWidget(top_widget); layout.addWidget(self.tabs)
        container = QWidget(); container.setLayout(layout)
        self.setCentralWidget(container)
        self.setStyleSheet(f"QMainWindow {{ background:{BG}; }}")

        self._shortcuts()
        self.add_tab(start_url)

    # ── blocklist extend button ───────────────────────────────────────────
    def _style_btn(self, border):
        self.extend_btn.setStyleSheet(f"""
            QPushButton {{ background:{BG}; color:{FG}; border:none; padding:9px 14px;
                          font-family:'JetBrainsMono Nerd Font'; font-size:13px;
                          border-bottom:2px solid {border}; }}
            QPushButton:hover {{ color:{ACCENT}; }}
            QPushButton:disabled {{ color:{GREEN}; }}""")

    def extend_blocklist(self):
        if self._extended:
            return
        # Immediately merge the extra built-ins + any local blocklist.txt.
        merged = set(self.interceptor.domains) | EXTRA_BLOCKLIST | load_local_blocklist()
        self.interceptor.domains = merged   # atomic swap; interceptor reads fresh
        if (CONFIG_DIR / "blocklist.txt").exists():
            self._set_extended(len(merged))
        else:
            # No local list → pull StevenBlack's hosts in the background.
            self.extend_btn.setText("⏳")
            self.extend_btn.setEnabled(False)
            self._worker = FetchWorker()
            self._worker.done.connect(self._fetch_done)
            self._worker.start()

    def _fetch_done(self, domains):
        merged = set(self.interceptor.domains) | domains
        self.interceptor.domains = merged
        self._set_extended(len(merged))

    def _set_extended(self, count):
        self._extended = True
        self.extend_btn.setText(f"🛡 {count}")
        self.extend_btn.setEnabled(False)
        self.extend_btn.setToolTip(f"Extended blocklist active — {count} domains blocked")
        self._style_btn(GREEN)
        print(f"blocklist extended → {count} domains")

    def add_tab(self, url=None):
        view = QWebEngineView()
        view.setPage(LegendPage(self.profile, self))
        view.urlChanged.connect(lambda q, v=view: self._url_changed(v, q))
        view.titleChanged.connect(lambda t, v=view: self._title_changed(v, t))
        view.loadProgress.connect(lambda p, v=view: self._progress(v, p))
        idx = self.tabs.addTab(view, "New Tab")
        self.tabs.setCurrentIndex(idx)
        view.setUrl(QUrl(url or HOME_URL))
        return view

    def close_tab(self, idx):
        if self.tabs.count() <= 1:
            self.add_tab()
        w = self.tabs.widget(idx)
        self.tabs.removeTab(idx)
        w.deleteLater()

    def current(self):
        return self.tabs.currentWidget()

    def _tab_changed(self, _):
        v = self.current()
        if v:
            self.url_bar.setText(v.url().toString())

    def _url_changed(self, view, q):
        if view is self.current():
            self.url_bar.setText(q.toString())

    def _title_changed(self, view, title):
        idx = self.tabs.indexOf(view)
        if idx >= 0:
            self.tabs.setTabText(idx, (title[:22] + "…") if len(title) > 23 else title or "…")

    def _progress(self, view, pct):
        if 0 < pct < 100:
            idx = self.tabs.indexOf(view)
            if idx >= 0:
                self.tabs.setTabText(idx, f"… {pct}%")

    def navigate(self):
        text = self.url_bar.text().strip()
        if not text:
            return
        if " " in text or ("." not in text and not text.startswith(("http", "localhost", "about:"))):
            url = SEARCH_URL.format(QUrl.toPercentEncoding(text).data().decode())
        elif not text.startswith(("http://", "https://", "about:")):
            url = "https://" + text
        else:
            url = text
        self.current().setUrl(QUrl(url))

    def _install_scripts(self):
        for name, src in (("Silencer", SILENCER_JS), ("Keymap", KEYMAP_JS)):
            s = QWebEngineScript()
            s.setName(name)
            s.setSourceCode(src)
            s.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentReady)
            s.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
            s.setRunsOnSubFrames(False)
            self.profile.scripts().insert(s)

    def _on_download(self, item):
        dest = Path.home() / "Downloads"
        dest.mkdir(exist_ok=True)
        item.setDownloadDirectory(str(dest))
        item.accept()
        print(f"⬇ {item.downloadFileName()} → {dest}")

    def _shortcuts(self):
        def sc(seq, fn):
            QShortcut(QKeySequence(seq), self, activated=fn)
        sc("Ctrl+T", lambda: (self.add_tab(), self.url_bar.setFocus()))
        sc("Ctrl+W", lambda: self.close_tab(self.tabs.currentIndex()))
        sc("Ctrl+L", lambda: (self.url_bar.setFocus(), self.url_bar.selectAll()))
        sc("Ctrl+R", lambda: self.current().reload())
        sc("F5", lambda: self.current().reload())
        sc("Alt+Left", lambda: self.current().back())
        sc("Alt+Right", lambda: self.current().forward())
        sc("Ctrl+Tab", lambda: self.tabs.setCurrentIndex((self.tabs.currentIndex() + 1) % self.tabs.count()))
        sc("Ctrl+Shift+Tab", lambda: self.tabs.setCurrentIndex((self.tabs.currentIndex() - 1) % self.tabs.count()))
        sc("Ctrl+=", lambda: self.current().setZoomFactor(self.current().zoomFactor() + 0.1))
        sc("Ctrl++", lambda: self.current().setZoomFactor(self.current().zoomFactor() + 0.1))
        sc("Ctrl+-", lambda: self.current().setZoomFactor(self.current().zoomFactor() - 0.1))
        sc("Ctrl+0", lambda: self.current().setZoomFactor(1.0))
        sc("F11", lambda: self.showNormal() if self.isFullScreen() else self.showFullScreen())
        sc("Ctrl+Q", self.close)
        sc("Alt+Home", lambda: self.current().setUrl(QUrl(HOME_URL)))


if __name__ == "__main__":
    app = QApplication(sys.argv)
    start = sys.argv[1] if len(sys.argv) > 1 else HOME_URL
    if not start.startswith(("http", "about:")):
        start = "https://" + start
    win = LegendChrome(start)
    win.show()
    sys.exit(app.exec())
