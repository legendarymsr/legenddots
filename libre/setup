# =============================================================================
# 6. LLVM + Mesa — software/virtio GL for the X server and apps
#    (virtio-gpu via virgl; llvmpipe software fallback. All free.)
# =============================================================================
if ! step_done llvm; then
  header "LLVM ${LLVM_VER} (this is the long one — hours)"
  a=$(fetch "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VER}/llvm-${LLVM_VER}.src.tar.xz")
  ac=$(fetch "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VER}/cmake-${LLVM_VER}.src.tar.xz")
  al=$(fetch "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VER}/third-party-${LLVM_VER}.src.tar.xz")
  wd=$(mktemp -d "$SOURCES/llvm.XXXXXX")
  tar -xf "$a"  -C "$wd"
  tar -xf "$ac" -C "$wd"
  tar -xf "$al" -C "$wd"
  mv "$wd/cmake-${LLVM_VER}.src" "$wd/cmake"
  mv "$wd/third-party-${LLVM_VER}.src" "$wd/third-party"
  pushd "$wd/llvm-${LLVM_VER}.src" >/dev/null
  cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" -DLLVM_ENABLE_RTTI=ON \
    -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON -DLLVM_ENABLE_TERMINFO=OFF
  ninja -C build -j${NPROC}
  ninja -C build install
  popd >/dev/null
  rm -rf "$wd"
  mark_step llvm
fi
if ! step_done mesa; then
  header "Mesa ${MESA_VER} (virgl + swrast, no proprietary drivers)"
  a=$(fetch "https://mesa.freedesktop.org/archive/mesa-${MESA_VER}.tar.xz")
  bpkg "$a" bash -c "
    meson setup build --prefix=/usr --buildtype=release \
      -Dgallium-drivers=virgl,swrast -Dvulkan-drivers= \
      -Dplatforms=x11 -Dglx=dri -Dllvm=enabled -Dvalgrind=disabled \
      -Dlibunwind=disabled
    ninja -C build -j${NPROC}
    ninja -C build install
  "
  mark_step mesa
fi
if ! step_done libepoxy; then
  header "libepoxy ${LIBEPOXY_VER}"
  a=$(fetch "https://github.com/anholt/libepoxy/releases/download/${LIBEPOXY_VER}/libepoxy-${LIBEPOXY_VER}.tar.xz")
  bpkg "$a" bash -c "meson setup build --prefix=/usr --buildtype=release; ninja -C build; ninja -C build install"
  mark_step libepoxy
fi

