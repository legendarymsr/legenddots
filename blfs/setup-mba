# =============================================================================
if ! step_done brightnessctl; then
  header "brightnessctl ${BRIGHTNESSCTL_VER}"
  a=$(fetch "https://github.com/Hummer12007/brightnessctl/archive/refs/tags/${BRIGHTNESSCTL_VER}.tar.gz")
  bpkg "$a" bash -c "make -j${NPROC}; make install PREFIX=/usr"
  install -dm755 /etc/udev/rules.d
  cat > /etc/udev/rules.d/90-backlight.rules << 'EOF'
ACTION=="add", SUBSYSTEM=="backlight", \
  RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", \
  RUN+="/bin/chmod g+w   /sys/class/backlight/%k/brightness"
EOF
  mark_step brightnessctl
fi

# =============================================================================
# links (text-mode browser: fallback for Super+B)
# =============================================================================
if ! step_done links; then
  header "links ${LINKS_VER}"
  a=$(fetch "https://links.twibright.com/download/links-${LINKS_VER}.tar.bz2")
  bpkg "$a" bash -c "./configure --prefix=/usr --without-x --with-ssl; make -j${NPROC}; make install"
  mark_step links
fi

# =============================================================================
# 44. fastfetch
# =============================================================================
if ! step_done fastfetch; then
  header "fastfetch"
  FF_VER="2.26.1"
  a=$(fetch "https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/${FF_VER}.tar.gz")
  bpkg "$a" bash -c "cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -G Ninja .; ninja -j${NPROC}; ninja install"
  mark_step fastfetch
fi

# =============================================================================
# 45. Fonts
# =============================================================================
if ! step_done fonts; then
  header "Fonts"
  mkdir -p /usr/share/fonts/nerd-fonts /usr/share/fonts/noto
  jb_a=$(fetch "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.2.1/JetBrainsMono.tar.xz")
  tar -xf "$jb_a" -C /usr/share/fonts/nerd-fonts
  wget -q -O /usr/share/fonts/noto/NotoColorEmoji.ttf \
    "https://github.com/googlefonts/noto-emoji/raw/v2.047/fonts/NotoColorEmoji.ttf"
  fc-cache -fv
  mark_step fonts
fi

# =============================================================================
# 46. User setup — legend
# =============================================================================
if ! step_done user_setup; then
  header "User setup — legend"
  groupadd -f wheel; groupadd -f seat; groupadd -f render; groupadd -f video
  groupadd -f audio; groupadd -f input
  useradd -m -G wheel,audio,video,render,input,seat \
          -s /bin/zsh legend 2>/dev/null || true
  echo "legend:$(openssl passwd -6 'legendary')" | chpasswd -e

  if command -v doas &>/dev/null; then
    printf 'permit persist legend as root\n' > /etc/doas.conf
    chmod 0400 /etc/doas.conf
  else
    warn "doas not found — configure sudo or doas manually for 'legend'"
  fi

  if [[ -d /root/legenddots && ! -e /home/legend/legenddots ]]; then
    cp -a /root/legenddots /home/legend/legenddots
    chown -R legend:legend /home/legend/legenddots
  fi

  su legend -s /bin/bash -c "
    [ -d ~/legenddots ] || git clone https://github.com/legendarymsr/legenddots ~/legenddots
    mkdir -p ~/Pictures/Screenshots
    mkdir -p ~/.config/alacritty ~/.config/niri ~/.config/fastfetch
    ln -sfn ~/legenddots/alacritty.toml         ~/.config/alacritty/alacritty.toml
    ln -sfn ~/legenddots/.zshrc                 ~/.zshrc
    ln -sfn ~/legenddots/niri/config.kdl        ~/.config/niri/config.kdl
    ln -sfn ~/legenddots/niri/waybar            ~/.config/waybar
    ln -sfn ~/legenddots/niri/fuzzel            ~/.config/fuzzel
    ln -sfn ~/legenddots/niri/dunst             ~/.config/dunst
    ln -sfn ~/legenddots/niri/swaylock          ~/.config/swaylock
    ln -sfn ~/legenddots/niri/swaybg            ~/.config/swaybg
    ln -sfn ~/legenddots/fastfetch/config.jsonc ~/.config/fastfetch/config.jsonc
    ln -sfn ~/legenddots/wallpapers             ~/.config/wallpapers
    printf '%s\n' 'if [ -z \"\$WAYLAND_DISPLAY\" ] && [ \"\$(tty)\" = /dev/tty1 ]; then exec dbus-run-session niri; fi' > ~/.zprofile
  "

  cat > /etc/profile.d/xdg.sh << 'EOF'
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export MOZ_ENABLE_WAYLAND=1
EOF
  mkdir -p /etc/zsh
  printf '%s\n' 'emulate sh -c "source /etc/profile"' > /etc/zsh/zprofile

  cat > /etc/rc.d/init.d/xdg-runtime << 'EOF'
#!/bin/sh
### BEGIN INIT INFO
# Provides:          xdg-runtime
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Creates /run/user/<uid> for the desktop user
### END INIT INFO

case "$1" in
  start)
    uid=$(id -u legend) || exit 0
    install -d -m 0700 -o legend -g legend "/run/user/$uid"
    ;;
  stop) ;;
  *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
EOF
  chmod 755 /etc/rc.d/init.d/xdg-runtime
  ln -sfv ../init.d/xdg-runtime /etc/rc.d/rc3.d/S25xdg-runtime
  mark_step user_setup
fi

# =============================================================================
# 47. MacBook Air 6,2 hardware quirks
# =============================================================================
if ! step_done macbook_hw; then
  header "MacBook Air 6,2 hardware config"
  if ls /lib/modules/*/updates/wl.ko >/dev/null 2>&1; then
    ok "Broadcom wl.ko is installed (built in the base-system phase)"
  else
    warn "wl.ko is missing — wifi (BCM4360) will not work until the base-system phase is re-run"
  fi
  mark_step macbook_hw
fi

echo -e "\n${GREEN}Setup complete.${NC}"
echo -e "${CYAN}Estimated build time on MacBook Air 6,2: 30–40 hours (LLVM + clang and Rust crates are the bottleneck).${NC}"
echo -e "${CYAN}Reboot into LFS and log in on tty1 as 'legend' (password: legendary): niri starts automatically.${NC}"
