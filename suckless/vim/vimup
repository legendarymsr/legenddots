#!/usr/bin/env sh
# vimup — edit the suckless vim config, then commit (+push) if it changed.
#
#   vimup        edit the vimrc
#   vimup lsp    edit c-lsp.vim (the optional C LSP setup)
#
# Lives inside the repo, so it always knows where to commit — run it from
# anywhere. Push is best-effort: if you're offline the commit still lands and
# you can push later.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/../.." && pwd)

case "${1:-}" in
  ''|vimrc) rel="suckless/vim/vimrc" ;;
  lsp)      rel="suckless/vim/c-lsp.vim" ;;
  *) echo "usage: vimup [vimrc|lsp]" >&2; exit 2 ;;
esac

cd "$repo"
"${EDITOR:-vim}" "$rel"

if git diff --quiet -- "$rel"; then
  echo "vimup: no changes to $rel"
  exit 0
fi

git add -- "$rel"
git commit -m "vim: update $(basename "$rel")" -- "$rel"
echo "vimup: committed."
if git push; then
  echo "vimup: pushed."
else
  echo "vimup: push failed — commit is saved locally, push later with 'git -C $repo push'."
fi
