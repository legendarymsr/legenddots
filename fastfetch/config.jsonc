// legenddots fastfetch config — Tokyo Night keys, built-in LFS logo.
// Plain fastfetch modules only, so it works on any of the setups and with
// no Nerd Font. Colours are raw truecolor SGR codes (38;2;R;G;B), not
// "#rrggbb", which older fastfetch (blfs: 2.26.1) rejects.
//
//   libre/setup  installs it system-wide: /etc/xdg/fastfetch/config.jsonc
//                plus /etc/os-release (ID=lfs)
//   blfs/setup   symlinks it to ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "lfs",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;122;162;247",
      "title": "38;2;187;154;247",
      "output": "38;2;192;202;245",
      "separator": "38;2;86;95;137"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "initsystem",
      "key": "init"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "packages"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "swap",
      "key": "swap"
    },
    {
      "type": "disk",
      "key": "disk"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
