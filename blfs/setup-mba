fetch() {
  local url="$1"
  local out="$SOURCES/$(basename "$url")"
  if [[ ! -s "$out" ]]; then
    info "Fetching $(basename "$url")..." >&2
    wget -q --show-progress -c -O "$out" "$url" >&2 || { rm -f "$out"; die "Download failed: $url"; }
  fi
  echo "$out"
}

bpkg() {
  local archive="$1"; shift
  local bdir; bdir=$(mktemp -d "$SOURCES/build.XXXXXX")
  tar -xf "$archive" -C "$bdir" --strip-components=1
  pushd "$bdir" >/dev/null
  "$@"
  local rc=$?
  popd >/dev/null
  rm -rf "$bdir"
  return $rc
}

