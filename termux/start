#!/usr/bin/env bash
# pocketwl — start Termux:X11 and run the compositor nested inside it.
# Unrooted Android has no DRM/KMS, so wlroots uses its X11 backend: because
# DISPLAY points at the Termux:X11 server, pocketwl renders into an X11 window.
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Build (make is a no-op if pocketwl is already up to date, and rebuilds
# automatically when pocketwl.c changed — e.g. after a git pull).
if ! make -C "$DIR" pocketwl; then
  echo "build failed — run the full setup: bash $DIR/setup.sh" >&2
  exit 1
fi
chmod +x "$DIR/pocketwl" 2>/dev/null || true

# Wayland/X need a runtime dir; Termux sets $TMPDIR to $PREFIX/tmp.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-$PREFIX/tmp}}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

DISPLAY_NUM=":1"

# Start the Termux:X11 server (requires the Termux:X11 APK to be installed).
if ! pgrep -f "termux-x11 $DISPLAY_NUM" >/dev/null 2>&1; then
  echo ":: starting Termux:X11 on $DISPLAY_NUM ..."
  termux-x11 "$DISPLAY_NUM" >/dev/null 2>&1 &
  # give the X server a moment to come up
  for _ in $(seq 1 20); do
    [[ -e "$XDG_RUNTIME_DIR/../.X11-unix/X${DISPLAY_NUM#:}" ]] && break
    sleep 0.3
  done
  sleep 1
fi

export DISPLAY="$DISPLAY_NUM"
export POCKETWL_TERMINAL="${POCKETWL_TERMINAL:-foot}"

# Auto-pick an installed Wayland launcher for Alt+D (package availability varies
# across Termux mirrors — fuzzel isn't always there, wofi/tofi/bemenu often are).
if [[ -z "${POCKETWL_LAUNCHER:-}" ]]; then
  # Prefer a Wayland GUI launcher; then X11 ones (rofi/dmenu — they display on
  # the Termux:X11 server, and the app you pick launches into pocketwl as a
  # Wayland client since it inherits WAYLAND_DISPLAY); then the fzf fallback.
  if   command -v fuzzel     >/dev/null 2>&1; then export POCKETWL_LAUNCHER="fuzzel"
  elif command -v wofi       >/dev/null 2>&1; then export POCKETWL_LAUNCHER="wofi --show drun"
  elif command -v tofi-drun  >/dev/null 2>&1; then export POCKETWL_LAUNCHER="tofi-drun"
  elif command -v bemenu-run >/dev/null 2>&1; then export POCKETWL_LAUNCHER="bemenu-run"
  elif command -v rofi >/dev/null 2>&1; then export POCKETWL_LAUNCHER="rofi -show run"
  elif command -v dmenu_run  >/dev/null 2>&1; then export POCKETWL_LAUNCHER="dmenu_run"
  elif [[ -f "$DIR/launcher" ]] && command -v fzf >/dev/null 2>&1; then
    export POCKETWL_LAUNCHER="$POCKETWL_TERMINAL -e bash $DIR/launcher"
  fi
  [[ -n "${POCKETWL_LAUNCHER:-}" ]] && echo ":: Alt+D launcher: $POCKETWL_LAUNCHER" \
    || echo ":: no launcher found (Alt+D inert) — pkg install rofi"
fi

echo ":: launching pocketwl (open the Termux:X11 app to see it) ..."
# wlroots autodetects the X11 backend from DISPLAY. -s spawns a first terminal.
exec "$DIR/pocketwl" -s "$POCKETWL_TERMINAL"
