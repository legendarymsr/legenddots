#!/usr/bin/env bash
# =============================================================================
# rescue — finish an interrupted update + rebuild the kernel, IN PLACE.
# -----------------------------------------------------------------------------
# Run as root from INSIDE your Gentoo system — either booted normally, or after
# you've mounted + chrooted in from a live USB yourself. This script does NOT
# mount or chroot anything; it just runs the repair against the current root.
#
#   bash rescue                 # do everything
#   SKIP_WORLD=1  bash rescue    # kernel rebuild only
#   SKIP_KERNEL=1 bash rescue    # finish @world only
#
# From a live USB, mount + chroot first (once), then run it:
#   mount /dev/sda3 /mnt && mount /dev/sda1 /mnt/boot/efi
#   mount -t proc /proc /mnt/proc
#   mount --rbind /sys /mnt/sys && mount --make-rslave /mnt/sys
#   mount --rbind /dev /mnt/dev && mount --make-rslave /mnt/dev
#   mount --rbind /run /mnt/run && mount --make-rslave /mnt/run
#   echo nameserver 1.1.1.1 > /mnt/etc/resolv.conf
#   chroot /mnt /bin/bash        # then, inside:  source /etc/profile; bash rescue
#
# It: (1) finishes @world unattended, (2) rebuilds out-of-tree modules,
# (3) rebuilds the kernel with its existing .config + regenerates the initramfs,
# (4) repoints rEFInd's initrd=, (5) runs verify-boot. Idempotent — re-run after
# fixing whatever it stops on. Don't pipe it through `tee` (buffers the output);
# redirect instead:  bash rescue &> /tmp/rescue.log &  ;  tail -f /tmp/rescue.log
# =============================================================================
set -o pipefail   # NOT -e (push past benign failures) and NOT -u (sourcing
                  # /etc/profile trips nounset and would exit the script silently).

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
header()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
warn()    { echo -e "${YELLOW}  ! $*${NC}"; }
success() { echo -e "${GREEN}  ✓ $*${NC}"; }
info()    { echo -e "${CYAN}  → $*${NC}"; }
die()     { echo -e "${RED}  ✗ $*${NC}"; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root: bash rescue"
command -v emerge >/dev/null 2>&1 || die "no emerge here — you're not inside the Gentoo system (chroot in first)."
source /etc/profile 2>/dev/null || true

[[ -e /dev/fd ]] || warn "/dev/fd missing — portage may refuse to run (fix the chroot's /dev mounts)."
getent hosts gentoo.org >/dev/null 2>&1 || echo "nameserver 1.1.1.1" > /etc/resolv.conf

if [[ "${SKIP_WORLD:-}" != "1" ]]; then
  header "Finishing @world update (unattended — this is the long one)..."
  # --autounmask-continue writes needed USE/keyword changes and keeps going;
  # --keep-going means one bad package doesn't halt the rest.
  emerge --update --deep --newuse --with-bdeps=y --backtrack=100 \
         --autounmask-continue=y --keep-going=y @world \
    || warn "@world reported errors above — resolve them and re-run rescue."
  # NO --depclean here: gentoo-sources is deselected from @world (so it doesn't
  # derail resolution), which means depclean would DELETE the kernel source tree
  # + its .config and make the kernel rebuild below impossible. Run depclean by
  # hand on a healthy, booted system instead.
fi

# If the kernel source went missing (e.g. a past depclean removed it), re-emerge
# it and restore the .config from /boot so the rebuild below can run.
if [[ "${SKIP_KERNEL:-}" != "1" && ! -f /usr/src/linux/.config ]]; then
  warn "kernel .config missing — re-emerging gentoo-sources + restoring config..."
  emerge --oneshot "=sys-kernel/gentoo-sources-6.18*" 2>/dev/null || warn "gentoo-sources re-emerge failed"
  # point /usr/src/linux at the newest 6.18 tree
  NEWEST=$(ls -d /usr/src/linux-6.18* 2>/dev/null | sort -V | tail -1)
  [[ -n "$NEWEST" ]] && ln -sfn "$NEWEST" /usr/src/linux
  # restore the config saved by the last `make install`
  CFG=$(ls -t /boot/config-6.18* 2>/dev/null | head -1)
  [[ -n "$CFG" && ! -f /usr/src/linux/.config ]] && cp "$CFG" /usr/src/linux/.config \
    && success "restored .config from $(basename "$CFG")"
fi

header "Rebuilding out-of-tree modules (wl.ko etc.)..."
# --usepkg=n: a stale broadcom-sta binpkg is built for a different kernel; using
# it leaves no wl.ko for this one. Force a source compile against /usr/src/linux.
emerge --usepkg=n @module-rebuild 2>/dev/null || warn "@module-rebuild failed — WiFi may break; rebuild net-wireless/broadcom-sta."

if [[ "${SKIP_KERNEL:-}" != "1" ]]; then
  KSRC=/usr/src/linux
  if [[ -f "$KSRC/.config" && -x "$KSRC/scripts/config" ]]; then
    KVER=$(cd "$KSRC" && make -s kernelrelease 2>/dev/null)
    header "Rebuilding kernel ${KVER} with its existing .config..."
    # olddefconfig keeps your config, just resolves any new symbols. -j3 is safe
    # on the 4 GB Air (bigger -j OOMs gcc). make install rotates vmlinuz ->
    # vmlinuz.old and copies the new image to /boot.
    if ( cd "$KSRC" && make olddefconfig && make -j3 && make modules_install && make install ); then
      if command -v genkernel >/dev/null 2>&1; then
        genkernel --no-clean --no-mrproper --kernel-config="$KSRC/.config" initramfs \
          || warn "genkernel failed — initramfs NOT regenerated; do NOT reboot until fixed."
      else
        warn "genkernel missing — initramfs NOT regenerated (emerge sys-kernel/genkernel)."
      fi
      depmod -a "$KVER" 2>/dev/null || true
      # Repoint rEFInd's shared initrd= line at the (possibly renamed) initramfs.
      NEWINITRD=$(ls -t /boot/initramfs-*"$KVER"*.img 2>/dev/null | head -1)
      if [[ -n "$NEWINITRD" && -f /boot/refind_linux.conf ]]; then
        sed -i "s|initrd=/boot/initramfs-[^ \"]*|initrd=/boot/$(basename "$NEWINITRD")|" \
          /boot/refind_linux.conf && success "refind_linux.conf initrd -> $(basename "$NEWINITRD")"
      fi
      success "Kernel ${KVER} rebuilt + installed."
    else
      die "kernel build failed — fix the error above and re-run rescue."
    fi
  else
    warn "No kernel .config at $KSRC — skipping kernel rebuild (set the source with eselect kernel)."
  fi
fi

# verify-boot from wherever the repo lives
for p in /root/legenddots /home/legend/legenddots /legenddots; do
  if [[ -f "$p/gentoo/troubleshooting/verify-boot" ]]; then
    header "verify-boot"
    bash "$p/gentoo/troubleshooting/verify-boot" || true
    break
  fi
done

header "Done."
success "If verify-boot is green: exit the chroot, unmount, and reboot into your kernel."
