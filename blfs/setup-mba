      killproc -p /run/wpa_supplicant-wlan0.pid /usr/sbin/wpa_supplicant
      ip link set wlan0 down 2>/dev/null
      evaluate_retval
      ;;
   restart)
      ${0} stop
      sleep 1
      ${0} start
      ;;
   *)
      echo "Usage: ${0} {start|stop|restart}"
      exit 1
      ;;
esac

# End network
EOF2
