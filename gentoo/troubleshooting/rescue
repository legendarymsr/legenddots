#!/usr/bin/env bash
# =============================================================================
# rescue — repair a bricked Gentoo install from a live USB (chroot recovery)
# -----------------------------------------------------------------------------
# Run as root from ANY live Linux (EndeavourOS, SystemRescue, Gentoo minimal):
#
#   sudo bash rescue                      # auto-detect disk, do everything
#   ROOT_DEV=/dev/sdb3 sudo bash rescue    # override if auto-detect is wrong
#
# Over SSH on flaky WiFi, wrap it so a drop can't kill it:
#   sudo nohup bash rescue > /tmp/rescue.log 2>&1 &   ;  tail -f /tmp/rescue.log
#
# What it does, in order:
#   1. finds + mounts your Gentoo root (+ EFI) and the API filesystems with a
#      SANE /dev (the /dev/fd portage needs), and fixes DNS in the chroot
#   2. chroots in and finishes any interrupted `@world` update, UNATTENDED
#   3. rebuilds out-of-tree modules (wl.ko)
#   4. rebuilds the kernel with its EXISTING .config + regenerates the initramfs
#   5. repoints rEFInd's initrd= at the rebuilt initramfs
#   6. runs verify-boot
#
# Every step is idempotent — safe to re-run after fixing whatever it stops on.
# Skips: SKIP_WORLD=1 (no @world), SKIP_KERNEL=1 (no kernel rebuild).
# =============================================================================
set -uo pipefail   # NOT -e: a recovery must push past benign failures.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
header()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
warn()    { echo -e "${YELLOW}  ! $*${NC}"; }
success() { echo -e "${GREEN}  ✓ $*${NC}"; }
info()    { echo -e "${CYAN}  → $*${NC}"; }
die()     { echo -e "${RED}  ✗ $*${NC}"; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root: sudo bash rescue"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 2 — inside the chroot (re-exec'd from phase 1, or run with --inside on a
# system you've already chrooted into / booted).
# ─────────────────────────────────────────────────────────────────────────────
if [[ "${RESCUE_INSIDE:-}" == "1" || "${1:-}" == "--inside" ]]; then
  source /etc/profile 2>/dev/null || true

  [[ -e /dev/fd ]] || warn "/dev/fd missing — portage may refuse to run (bad host mounts)."
  getent hosts gentoo.org >/dev/null 2>&1 || echo "nameserver 1.1.1.1" > /etc/resolv.conf

  if [[ "${SKIP_WORLD:-}" != "1" ]]; then
    header "Finishing @world update (unattended — this is the long one)..."
    # --autounmask-continue writes needed USE/keyword changes and keeps going;
    # --keep-going means one bad package doesn't halt the rest.
    emerge --update --deep --newuse --with-bdeps=y --backtrack=100 \
           --autounmask-continue=y --keep-going=y @world \
      || warn "@world reported errors above — resolve them and re-run rescue."
    emerge --depclean 2>/dev/null || true
  fi

  header "Rebuilding out-of-tree modules (wl.ko etc.)..."
  emerge @module-rebuild 2>/dev/null || warn "@module-rebuild failed — WiFi may break; rebuild net-wireless/broadcom-sta."

  if [[ "${SKIP_KERNEL:-}" != "1" ]]; then
    KSRC=/usr/src/linux
    if [[ -f "$KSRC/.config" && -x "$KSRC/scripts/config" ]]; then
      KVER=$(cd "$KSRC" && make -s kernelrelease 2>/dev/null)
      header "Rebuilding kernel ${KVER} with its existing .config..."
      # olddefconfig keeps your config, just resolves any new symbols. -j3 is
      # safe on the 4 GB Air (bigger -j OOMs gcc). make install rotates
      # vmlinuz -> vmlinuz.old and copies the new image to /boot.
      if ( cd "$KSRC" && make olddefconfig && make -j3 && make modules_install && make install ); then
        if command -v genkernel >/dev/null 2>&1; then
          genkernel --no-clean --no-mrproper --kernel-config="$KSRC/.config" initramfs \
            || warn "genkernel failed — initramfs NOT regenerated; do NOT reboot until fixed."
        else
          warn "genkernel missing — initramfs NOT regenerated (emerge sys-kernel/genkernel)."
        fi
        depmod -a "$KVER" 2>/dev/null || true
        # Repoint rEFInd's shared initrd= line at the (possibly renamed) initramfs.
        NEWINITRD=$(ls -t /boot/initramfs-*"$KVER"*.img 2>/dev/null | head -1)
        if [[ -n "$NEWINITRD" && -f /boot/refind_linux.conf ]]; then
          sed -i "s|initrd=/boot/initramfs-[^ \"]*|initrd=/boot/$(basename "$NEWINITRD")|" \
            /boot/refind_linux.conf && success "refind_linux.conf initrd -> $(basename "$NEWINITRD")"
        fi
        success "Kernel ${KVER} rebuilt + installed."
      else
        die "kernel build failed — fix the error above and re-run rescue."
      fi
    else
      warn "No kernel .config at $KSRC — skipping kernel rebuild (set the source with eselect kernel)."
    fi
  fi

  # verify-boot from wherever the repo lives
  for p in /home/legend/legenddots /root/legenddots /legenddots; do
    if [[ -f "$p/gentoo/troubleshooting/verify-boot" ]]; then
      header "verify-boot"
      bash "$p/gentoo/troubleshooting/verify-boot" || true
      break
    fi
  done

  header "Chroot recovery done."
  success "If verify-boot is green: exit, unmount, and reboot into your kernel."
  exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — on the live host: find the disk, mount everything, chroot, re-exec.
# ─────────────────────────────────────────────────────────────────────────────
MNT="${MNT:-/mnt/gentoo}"

disk_of() {  # /dev/sda3 -> /dev/sda ; /dev/nvme0n1p3 -> /dev/nvme0n1
  case "$1" in
    /dev/nvme*n*p*) echo "${1%p*}" ;;
    /dev/mmcblk*p*) echo "${1%p*}" ;;
    *)              echo "${1%%[0-9]*}" ;;
  esac
}

# Auto-detect the Gentoo root: an ext4 partition holding a Gentoo userland.
detect_root() {
  local dev tmp
  while read -r dev; do
    tmp=$(mktemp -d)
    if mount -o ro "$dev" "$tmp" 2>/dev/null; then
      if [[ -f "$tmp/etc/portage/make.conf" && -d "$tmp/usr/src" ]]; then
        umount "$tmp"; rmdir "$tmp"; echo "$dev"; return 0
      fi
      umount "$tmp" 2>/dev/null || true
    fi
    rmdir "$tmp" 2>/dev/null || true
  done < <(lsblk -lnpo NAME,FSTYPE | awk '$2=="ext4"{print $1}')
  return 1
}

header "Locating your Gentoo install..."
ROOT_DEV="${ROOT_DEV:-$(detect_root || true)}"
[[ -n "$ROOT_DEV" ]] || die "couldn't find a Gentoo root; pass it: ROOT_DEV=/dev/sdXN sudo bash rescue"
DISK=$(disk_of "$ROOT_DEV")
EFI_DEV="${EFI_DEV:-$(lsblk -lnpo NAME,FSTYPE "$DISK" 2>/dev/null | awk '$2=="vfat"{print $1; exit}')}"
info "root: $ROOT_DEV   efi: ${EFI_DEV:-<none found>}   mount: $MNT"

header "Mounting root + EFI + API filesystems..."
mkdir -p "$MNT"
mountpoint -q "$MNT" || mount "$ROOT_DEV" "$MNT" || die "mount $ROOT_DEV failed"
if [[ -n "$EFI_DEV" ]]; then
  mkdir -p "$MNT/boot/efi"
  mountpoint -q "$MNT/boot/efi" || mount "$EFI_DEV" "$MNT/boot/efi" || warn "EFI mount failed (not fatal for a rebuild)"
fi
# A sane /dev (incl. /dev/fd -> /proc/self/fd) is what portage validates.
mountpoint -q "$MNT/proc" || mount -t proc /proc "$MNT/proc"
mountpoint -q "$MNT/sys"  || { mount --rbind /sys "$MNT/sys"; mount --make-rslave "$MNT/sys"; }
mountpoint -q "$MNT/dev"  || { mount --rbind /dev "$MNT/dev"; mount --make-rslave "$MNT/dev"; }
mountpoint -q "$MNT/run"  || { mount --rbind /run "$MNT/run"; mount --make-rslave "$MNT/run"; }
getent hosts gentoo.org >/dev/null 2>&1 && cp -L /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null \
  || echo "nameserver 1.1.1.1" > "$MNT/etc/resolv.conf"
success "Mounted. /dev/fd in chroot: $(readlink -f "$MNT/dev/fd" 2>/dev/null || echo '?')"

header "Entering chroot to finish the repair..."
SELF=$(readlink -f "$0")
cp "$SELF" "$MNT/tmp/.rescue-inner" && chmod +x "$MNT/tmp/.rescue-inner"
RESCUE_INSIDE=1 SKIP_WORLD="${SKIP_WORLD:-}" SKIP_KERNEL="${SKIP_KERNEL:-}" \
  chroot "$MNT" /tmp/.rescue-inner
rc=$?
rm -f "$MNT/tmp/.rescue-inner"

echo
if [[ $rc -eq 0 ]]; then
  success "Recovery finished. To reboot into your system:"
  echo "    sudo umount -R $MNT   # optional; a reboot unmounts anyway"
  echo "    sudo reboot           # then pick your kernel in rEFInd"
else
  warn "The chroot step exited non-zero ($rc). Read the output above, fix it,"
  warn "and re-run:  sudo bash rescue   (it resumes cleanly)."
fi
exit $rc
