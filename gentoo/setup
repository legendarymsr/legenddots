#!/usr/bin/env bash
# =============================================================================
# Gentoo Software Setup — MacBook Air 6,2
# Installs all packages and configures the system on an already-installed
# Gentoo. Does NOT touch disks, partitions, bootloader, or kernel image.
# Run as root.
# =============================================================================
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root: doas bash gentoo/setup"; exit 1; }

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
header()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
warn()    { echo -e "${YELLOW}  ! $*${NC}"; }
success() { echo -e "${GREEN}  ✓ $*${NC}"; }
ok()      { echo -e "${GREEN}  ✓ $*${NC}"; }
info()    { echo -e "${CYAN}  → $*${NC}"; }
die()     { echo -e "${RED}  ✗ $*${NC}"; exit 1; }

# ── Options ──────────────────────────────────────────────────────────────────
if [[ -z "${ENABLE_WD40:-}" ]]; then
  echo -e "${CYAN}Apply WD-40 (mask rust USE flag where optional)? [Y/n] (10s, default: Y)${NC}"
  read -t 10 -r WD40_ANSWER || true; echo
  case "${WD40_ANSWER,,}" in n|no) ENABLE_WD40="false" ;; *) ENABLE_WD40="true" ;; esac
fi
if [[ -z "${PRIV_ESC:-}" ]]; then
  echo -e "${CYAN}Privilege escalation tool? [doas/sudo] (10s, default: doas)${NC}"
  read -t 10 -r PRIV_ANSWER || true; echo
  case "${PRIV_ANSWER,,}" in sudo) PRIV_ESC="sudo" ;; *) PRIV_ESC="doas" ;; esac
fi
if [[ -z "${REBUILD_WORLD:-}" ]]; then
  echo -e "${CYAN}Rebuild @world with updated USE flags after setup? Long (hours). [y/N] (10s, default: N)${NC}"
  read -t 10 -r RW_ANSWER || true; echo
  case "${RW_ANSWER,,}" in y|yes) REBUILD_WORLD="true" ;; *) REBUILD_WORLD="false" ;; esac
fi
if [[ -z "${REBUILD_KERNEL:-}" ]]; then
  echo -e "${CYAN}Rebuild the kernel with hardened .config after setup? ~45 min. [y/N] (10s, default: N)${NC}"
  read -t 10 -r RK_ANSWER || true; echo
  case "${RK_ANSWER,,}" in y|yes) REBUILD_KERNEL="true" ;; *) REBUILD_KERNEL="false" ;; esac
fi
if [[ -z "${INSTALL_VIRT:-}" ]]; then
  echo -e "${CYAN}Install QEMU/KVM + libvirt virtualization? [Y/n] (10s, default: Y)${NC}"
  read -t 10 -r VIRT_ANSWER || true; echo
  case "${VIRT_ANSWER,,}" in n|no) INSTALL_VIRT="false" ;; *) INSTALL_VIRT="true" ;; esac
fi
if [[ -z "${INSTALL_WAYDROID:-}" ]]; then
  echo -e "${CYAN}Install Waydroid (Android container)? [Y/n] (10s, default: Y)${NC}"
  read -t 10 -r WD_ANSWER || true; echo
  case "${WD_ANSWER,,}" in n|no) INSTALL_WAYDROID="false" ;; *) INSTALL_WAYDROID="true" ;; esac
fi
ENABLE_WD40="${ENABLE_WD40:-true}"
PRIV_ESC="${PRIV_ESC:-doas}"
REBUILD_WORLD="${REBUILD_WORLD:-false}"
REBUILD_KERNEL="${REBUILD_KERNEL:-false}"
INSTALL_VIRT="${INSTALL_VIRT:-true}"
INSTALL_WAYDROID="${INSTALL_WAYDROID:-true}"

# ── Checkpointing ─────────────────────────────────────────────────────────────
STATE_FILE=/etc/gentoo-setup.state
touch "$STATE_FILE"
step_done() { grep -qx "$1" "$STATE_FILE"; }
mark_step() { echo "$1" >> "$STATE_FILE"; }

export DEBUGINFOD_URLS="" DEBUGINFOD_URLS_CERT_PATH=""
set +u; source /etc/profile; set -u
export PATH="/usr/sbin:/usr/local/sbin:/sbin:${PATH}"
echo 1 > /proc/sys/vm/overcommit_memory
echo 262144 > /proc/sys/vm/max_map_count

# 1. PORTAGE SYNC & PROFILE
if ! step_done portage_sync; then
  header "Syncing portage tree..."
  emerge-webrsync
  # no-multilib profile: a genuinely 32-bit-free system. Enforces ABI_X86=64 and
  # drops the 32-bit toolchain entirely (nothing here needs it — no Wine/Steam).
  eselect profile set default/linux/amd64/23.0/no-multilib/hardened
  mark_step portage_sync
fi

# 2. KEYWORDS
mkdir -p /etc/portage/package.accept_keywords
{
  echo "*/*::guru ~amd64"
  echo "*/*::hyproverlay ~amd64"
  echo "*/*::another-brave-overlay ~amd64"
} > /etc/portage/package.accept_keywords/legend

# 3. MAKE.CONF
if ! step_done make_conf; then
  header "Writing make.conf..."
  cat > /etc/portage/make.conf << 'EOF'
COMMON_FLAGS="-march=haswell -O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
MAKEOPTS="-j3"
EMERGE_DEFAULT_OPTS="--jobs=1 --load-average=3 --quiet-build=y --usepkg=y --getbinpkg=n --backtrack=100 --autounmask-write=y --autounmask-continue=y"
CPU_FLAGS_X86="aes avx avx2 bmi bmi2 f16c fma3 mmx mmxext pclmul popcnt sse sse2 sse3 sse4_1 sse4_2 ssse3"
VIDEO_CARDS="intel iris"
ABI_X86="64"
LLVM_TARGETS="X86"
USE="udev elogind dbus wayland alsa seccomp -systemd -gnome -kde -qt5 -cups -pulseaudio -cuda -rocm -vdpau -nls -introspection -gtk-doc -doc -static-libs"
PYTHON_TARGETS="python3_13"
PYTHON_SINGLE_TARGET="python3_13"
FEATURES="ccache parallel-fetch buildpkg"
CCACHE_DIR="/var/cache/ccache"
PKGDIR="/var/cache/binpkgs"
ACCEPT_KEYWORDS="~amd64"
ACCEPT_LICENSE="*"
GENTOO_MIRRORS="https://ftp.lysator.liu.se/gentoo https://mirrors.dotsrc.org/gentoo"
EOF
  mkdir -p /var/cache/ccache /var/cache/binpkgs
  chown -R portage:portage /var/cache/ccache /var/cache/binpkgs
  mark_step make_conf
fi

# 4. PACKAGE USE FLAGS
if ! step_done package_use; then
  header "Writing package.use..."
  mkdir -p /etc/portage/package.use /etc/portage/package.env /etc/portage/package.env
  { echo "llvm-core/llvm -debug -binutils-plugin -libffi"
    echo "llvm-core/clang -debug -extra -static-analyzer"
  } > /etc/portage/package.use/llvm
  echo "llvm-runtimes/clang-runtime -sanitize -openmp" > /etc/portage/package.use/llvm-runtimes
  echo "media-video/pipewire sound-server"              > /etc/portage/package.use/pipewire
  echo "media-video/wireplumber elogind"                > /etc/portage/package.use/wireplumber
  echo "sys-auth/polkit elogind"                        > /etc/portage/package.use/polkit
  echo "net-misc/networkmanager tools"                  > /etc/portage/package.use/networkmanager
  echo "sys-auth/elogind pam"                           > /etc/portage/package.use/elogind
  echo "gui-apps/waybar tray wireplumber"               > /etc/portage/package.use/waybar
  echo "gui-apps/swaybg gdk-pixbuf"                    > /etc/portage/package.use/swaybg
  echo "x11-libs/gdk-pixbuf jpeg"                      > /etc/portage/package.use/gdk-pixbuf
  # Belt-and-suspenders: the no-multilib profile already forces this off, but
  # pinning it keeps gcc 32-bit-free even if the profile ever changes. Remove
  # both this and the no-multilib profile if you ever need Wine / 32-bit binaries.
  echo "sys-devel/gcc -multilib"                       > /etc/portage/package.use/gcc
  echo "media-fonts/nerdfonts jetbrainsmono"            > /etc/portage/package.use/nerdfonts
  echo "media-libs/libglvnd X"                          > /etc/portage/package.use/libglvnd
  echo "media-libs/mesa -llvm"                          > /etc/portage/package.use/mesa
  echo "sys-auth/seatd server"                          > /etc/portage/package.use/seatd
  # Terminal-only emacs (no X/GTK GUI) — runs in alacritty like neovim, lighter
  # deps. tree-sitter for fast syntax. Used via the emacs --daemon + emacsclient.
  echo "app-editors/emacs -X -gtk tree-sitter"          > /etc/portage/package.use/emacs
  { echo "x11-libs/cairo X"
    echo "x11-libs/pango X"
    echo "x11-libs/libxkbcommon X"
    echo "dev-libs/libdbusmenu gtk3"
    echo "dev-cpp/cairomm X"
    echo "dev-cpp/atkmm X"
    # gtk+ (and gtkmm, which ties its X to gtk+'s via [X=]) MUST carry X: both
    # brave-browser-nightly and qemu's gtk display hard-require gtk+:3[X]. Without
    # it, `--changed-use @world` tries to rebuild gtk+ as -X and slot-conflicts.
    echo "x11-libs/gtk+:3 introspection X"
    echo "dev-cpp/gtkmm X"
    echo "dev-libs/atk introspection"
  } > /etc/portage/package.use/xlibs
  echo "gnome-base/librsvg -introspection -vala" > /etc/portage/package.use/librsvg

  # O1 env for slow build-tool packages
  mkdir -p /etc/portage/env
  printf 'CFLAGS="-march=haswell -O1 -pipe"\nCXXFLAGS="-march=haswell -O1 -pipe"\nLDFLAGS="-fuse-ld=mold"\n' \
    > /etc/portage/env/O1.conf
  { echo "llvm-core/llvm O1.conf"
    echo "llvm-core/clang O1.conf"
    echo "media-libs/mesa O1.conf"
  } > /etc/portage/package.env/O1

  mark_step package_use
fi

# 5. OVERLAYS
if ! step_done overlays; then
  header "Setting up overlays..."
  emerge --oneshot app-eselect/eselect-repository dev-vcs/git
  eselect repository enable guru
  eselect repository add another-brave-overlay git \
      https://github.com/falbrechtskirchinger/another-brave-overlay.git || true
  eselect repository add hyproverlay git \
      https://codeberg.org/hyproverlay/hyproverlay.git || true
  emaint sync --repo guru                  || true
  emaint sync --repo another-brave-overlay || true
  emaint sync --repo hyproverlay           || true
  mark_step overlays
fi

# 6. WD-40
if ! step_done wd40; then
  if [[ "$ENABLE_WD40" == "true" ]]; then
    header "Applying WD-40 (masking optional rust)..."
    eselect repository create local || true
    echo "profile-formats = portage-2" >> /var/db/repos/local/metadata/layout.conf
    mkdir -p /var/db/repos/local/profiles/wd40-hardened
    echo "8" > /var/db/repos/local/profiles/wd40-hardened/eapi
    # Parent on the no-multilib hardened profile — keeps the system 32-bit-free.
    { echo "gentoo:default/linux/amd64/23.0/no-multilib/hardened"
      echo "gentoo:features/wd40"
    } > /var/db/repos/local/profiles/wd40-hardened/parent
    echo "amd64 wd40-hardened stable" > /var/db/repos/local/profiles/profiles.desc
    WD40_NUM=$(eselect profile list | sed -n 's/^[[:space:]]*\[\([0-9]\+\)\][[:space:]]\+local:wd40-hardened.*/\1/p')
    eselect profile set "${WD40_NUM}"
    mkdir -p /etc/portage/package.unmask
    { echo "x11-terms/alacritty"
      echo "gnome-base/librsvg"
    } > /etc/portage/package.unmask/wd40-exceptions
    rm -f /etc/portage/package.unmask/alacritty
  fi
  mark_step wd40
fi

# 7. CCACHE & MOLD
if ! step_done ccache; then
  header "Installing ccache..."
  emerge dev-util/ccache
  CCACHE_DIR=/var/cache/ccache ccache --max-size=12G
  CCACHE_DIR=/var/cache/ccache ccache --set-config=compression=true
  chown -R portage:portage /var/cache/ccache
  mark_step ccache
fi
if ! step_done mold; then
  header "Installing mold linker..."
  echo "sys-devel/mold -debug -mimalloc -test" > /etc/portage/package.use/mold
  emerge sys-devel/mold
  mark_step mold
fi

# 8. BASE SYSTEM
if ! step_done base_system; then
  header "Emerging base system..."
  groupadd -f plugdev; groupadd -f bluetooth

  PRIV_PKG="app-admin/doas"
  [[ "$PRIV_ESC" == "sudo" ]] && PRIV_PKG="app-admin/sudo"

  emerge \
    sys-apps/pciutils sys-apps/usbutils sys-process/procps \
    app-misc/figlet x11-apps/igt-gpu-tools \
    sys-auth/elogind net-misc/networkmanager net-wireless/wpa_supplicant \
    sys-auth/seatd net-wireless/broadcom-sta net-wireless/bluez \
    "$PRIV_PKG" sys-apps/dbus sys-auth/polkit \
    sys-power/acpid sys-power/tlp sys-apps/lm-sensors \
    net-misc/wget app-shells/zsh dev-vcs/git app-editors/neovim app-editors/emacs \
    media-video/pipewire media-video/wireplumber media-sound/alsa-utils \
    sys-fs/exfatprogs sys-fs/fuse \
    x11-terms/alacritty llvm-core/llvm llvm-core/clang app-misc/tmux app-misc/screen
  mark_step base_system
fi

# Always ensure gtk+ introspection + X is set (bypasses package_use checkpoint for
# reruns). X is non-negotiable here — brave and qemu[gtk] require gtk+:3[X], and
# gtkmm[X=] must match — so keep it in the always-runs block to self-heal a system
# whose gtk+ drifted to -X (the slot conflict a bare `--changed-use @world` hits).
{ echo "x11-libs/gtk+:3 introspection X"
  echo "dev-cpp/gtkmm X"
  echo "dev-libs/atk introspection"
} > /etc/portage/package.use/gtk-introspection

# Always ensure WiFi power management is OFF — Broadcom wl drops the connection
# under idle/load with it on. Persist it in both NetworkManager and TLP.
mkdir -p /etc/NetworkManager/conf.d
printf '[connection]\nwifi.powersave = 2\n' > /etc/NetworkManager/conf.d/wifi-powersave.conf
if [[ -f /etc/tlp.conf ]] && ! grep -q '^WIFI_PWR_ON_BAT=off' /etc/tlp.conf; then
  printf '\n# Broadcom wl drops with WiFi power saving on — keep it off.\nWIFI_PWR_ON_AC=off\nWIFI_PWR_ON_BAT=off\n' >> /etc/tlp.conf
fi

# 9. DESKTOP
if ! step_done desktop; then
  header "Emerging desktop (niri + Wayland stack)..."
  # Fix nerdfonts ebuild if broken (missing S="${WORKDIR}")
  NERDFONTS_EBUILD="/var/db/repos/guru/media-fonts/nerdfonts/nerdfonts-3.4.0.ebuild"
  if [[ -f "$NERDFONTS_EBUILD" ]] && ! grep -q '^S="${WORKDIR}"' "$NERDFONTS_EBUILD"; then
    sed -i '/^FONT_SUFFIX=""$/a\S="${WORKDIR}"' "$NERDFONTS_EBUILD"
  fi
  emerge --oneshot dev-perl/XML-Parser
  emerge \
    gui-wm/niri gui-apps/waybar gui-apps/fuzzel gui-apps/swaylock \
    gui-apps/swaybg gui-apps/grim gui-apps/slurp gui-apps/wl-clipboard \
    x11-misc/dunst gui-libs/xdg-desktop-portal-gtk gnome-extra/polkit-gnome \
    media-sound/pavucontrol x11-misc/xdg-utils x11-misc/xdg-user-dirs \
    media-fonts/nerdfonts sys-apps/brightnessctl www-client/brave-browser-nightly \
    app-misc/yazi
  mark_step desktop
fi

# 10. LOCALIZATION & USER
if ! step_done localization_user; then
  header "Localization and user setup..."
  echo "Europe/Stockholm" > /etc/timezone
  emerge --config sys-libs/timezone-data
  sed -i 's/keymap="us"/keymap="se"/' /etc/conf.d/keymaps
  grep -q "en_US.UTF-8" /etc/locale.gen || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
  grep -q "sv_SE.UTF-8" /etc/locale.gen || echo "sv_SE.UTF-8 UTF-8" >> /etc/locale.gen
  locale-gen
  eselect locale set en_US.utf8
  env-update && set +u && source /etc/profile && set -u

  groupadd -f seat; groupadd -f render
  useradd -m -G wheel,audio,video,render,input,usb,plugdev,bluetooth,seat -s /bin/zsh legend || true
  echo "legend:$(openssl passwd -6 'legendary')" | chpasswd -e
  echo "root:$(openssl passwd -6 'legendary123')" | chpasswd -e

  if [[ "$PRIV_ESC" == "sudo" ]]; then
    echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel
    chmod 0440 /etc/sudoers.d/wheel
  else
    SEATD_BIN=$(command -v seatd 2>/dev/null || echo /usr/bin/seatd)
    printf 'permit nopass legend as root cmd %s\npermit persist legend as root\n' "$SEATD_BIN" \
      > /etc/doas.conf
    chmod 0400 /etc/doas.conf
  fi

  su - legend -c "
    git clone https://github.com/legendarymsr/legenddots ~/legenddots || \
      (cd ~/legenddots && git pull --ff-only)
    mkdir -p ~/Pictures/Screenshots
    mkdir -p ~/.config/alacritty ~/.config/niri ~/.config/nvim ~/.config/emacs ~/.local/bin
    ln -sfn ~/legenddots/alacritty.toml  ~/.config/alacritty/alacritty.toml
    ln -sfn ~/legenddots/.zshrc          ~/.zshrc
    ln -sfn ~/legenddots/suckless/screen/screenrc ~/.screenrc
    ln -sfn ~/legenddots/init.lua        ~/.config/nvim/init.lua
    mkdir -p ~/.config/tmux
    ln -sfn ~/legenddots/tmux.conf       ~/.config/tmux/tmux.conf
    ln -sfn ~/legenddots/init.el         ~/.config/emacs/init.el
    ln -sfn ~/legenddots/niri/config.kdl ~/.config/niri/config.kdl
    ln -sfn ~/legenddots/niri/waybar     ~/.config/waybar
    ln -sfn ~/legenddots/niri/fuzzel     ~/.config/fuzzel
    ln -sfn ~/legenddots/niri/dunst      ~/.config/dunst
    ln -sfn ~/legenddots/niri/swaylock   ~/.config/swaylock
    ln -sfn ~/legenddots/wallpapers      ~/.config/wallpapers
    mkdir -p ~/.config/swaybg
    ln -sfn ~/legenddots/wallpapers/6orjlq.jpg ~/.config/swaybg/wallpaper.jpg
  "
  xdg-user-dirs-update || true
  mark_step localization_user
fi

# 10b. EDITOR INTEGRATION (system-wide) — make nvim/emacs the OS default editor
# for EVERY context (root, cron, doas -e, non-login/non-zsh shells, TTY), not just
# the interactive zsh session. This is what makes the editors feel woven into the
# OS rather than being a shell alias.
if ! step_done editor_integration; then
  header "Wiring editors system-wide (nvim + emacs)..."
  # Find the repo (cloned to legend's home by the dotfiles step; fall back to root's).
  EDSRC=""
  for d in /home/legend/legenddots /root/legenddots "$(dirname "$(dirname "$(readlink -f "$0")")")"; do
    [[ -f "$d/scripts/edit" && -f "$d/scripts/editor" ]] && { EDSRC="$d"; break; }
  done
  if [[ -n "$EDSRC" ]]; then
    # The switcher + the switch command, in /usr/local/bin (on every user's PATH,
    # incl. root and cron). Copies (not symlinks) so they don't depend on a home dir.
    install -m755 "$EDSRC/scripts/edit"   /usr/local/bin/edit
    install -m755 "$EDSRC/scripts/editor" /usr/local/bin/editor
    # System default (a per-user ~/.config/legend/editor overrides it).
    mkdir -p /etc/legend; [[ -f /etc/legend/editor ]] || echo nvim > /etc/legend/editor
    # The Gentoo way: EDITOR/VISUAL/SUDO_EDITOR for the whole system via /etc/env.d.
    cat > /etc/env.d/99legend-editor << 'EOF'
EDITOR=/usr/local/bin/edit
VISUAL=/usr/local/bin/edit
SUDO_EDITOR=/usr/local/bin/edit
MANPAGER="nvim +Man!"
EOF
    env-update >/dev/null 2>&1 || warn "env-update failed — run: doas env-update && . /etc/profile"
    # vi -> neovim system-wide (/usr/bin/vi), so even muscle-memory `vi` is nvim.
    emerge --noreplace app-eselect/eselect-vi >/dev/null 2>&1 || true
    eselect vi set nvim >/dev/null 2>&1 || warn "eselect vi set nvim failed — set it manually later"

    success "System editor = edit; man→nvim; vi→nvim (switch: 'editor nvim|emacs')."
    mark_step editor_integration
  else
    warn "repo scripts/edit not found — run the dotfiles step first, then rerun."
  fi
fi

# 10c. NEOVIM AS THE DESKTOP TEXT EDITOR — a .desktop app entry + default MIME
# handler, so opening a file from a file manager / xdg-open / "open with" lands in
# neovim. Its own step (not folded into 10b) so a rerun on an already-provisioned
# system still applies it.
if ! step_done nvim_desktop; then
  header "Making neovim the desktop default for text files..."
  DSRC=""
  for d in /home/legend/legenddots /root/legenddots "$(dirname "$(dirname "$(readlink -f "$0")")")"; do
    [[ -f "$d/niri/applications/nvim.desktop" ]] && { DSRC="$d"; break; }
  done
  if [[ -n "$DSRC" ]]; then
    emerge --noreplace x11-misc/xdg-utils dev-util/desktop-file-utils >/dev/null 2>&1 || true
    install -Dm644 "$DSRC/niri/applications/nvim.desktop" /usr/share/applications/nvim.desktop
    mkdir -p /etc/xdg
    cat > /etc/xdg/mimeapps.list << 'EOF'
[Default Applications]
text/plain=nvim.desktop
text/markdown=nvim.desktop
text/x-python=nvim.desktop
text/x-lua=nvim.desktop
text/x-shellscript=nvim.desktop
application/x-shellscript=nvim.desktop
text/x-csrc=nvim.desktop
text/x-chdr=nvim.desktop
text/x-c++src=nvim.desktop
text/x-rust=nvim.desktop
text/x-zig=nvim.desktop
application/json=nvim.desktop
application/toml=nvim.desktop
application/x-yaml=nvim.desktop
EOF
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    success "neovim is the desktop default for text files (file-manager / xdg-open)."
    mark_step nvim_desktop
  else
    warn "niri/applications/nvim.desktop not found — run the dotfiles step first, then rerun."
  fi
fi

# 11. SYSTEM CONFIG
if ! step_done sysconfig; then
  header "System configuration..."

  # Broadcom WiFi
  emerge --quiet net-wireless/broadcom-sta
  cat > /etc/modprobe.d/broadcom-sta.conf << 'EOF'
blacklist brcmfmac
blacklist brcmsmac
blacklist b43
blacklist b43legacy
blacklist ssb
blacklist bcma
EOF
  grep -q 'modules="wl"' /etc/conf.d/modules 2>/dev/null || \
    echo 'modules="wl"' >> /etc/conf.d/modules

  # Apple keyboard fn-mode (fn keys act as standard F1-F12 by default)
  echo "options hid_apple fnmode=2" > /etc/modprobe.d/hid_apple.conf

  # Cirrus Logic CS4208 (MacBook Air 6,2) — without model=mba6 the codec
  # doesn't initialize the speaker amp and audio is silent
  echo "options snd_hda_intel model=mba6" > /etc/modprobe.d/audio-mba.conf

  # Backlight permissions
  mkdir -p /etc/udev/rules.d
  cat > /etc/udev/rules.d/90-backlight.rules << 'EOF'
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
EOF

  # seatd OpenRC init script
  SEATD_BIN=$(command -v seatd 2>/dev/null || echo /usr/bin/seatd)
  if [[ ! -f /etc/init.d/seatd ]]; then
    cat > /etc/init.d/seatd << EOF
#!/sbin/openrc-run
name="seatd"
description="Seat management daemon"
command="$SEATD_BIN"
command_args="-g seat"
command_background="yes"
pidfile="/run/\${RC_SVCNAME}.pid"
EOF
    chmod +x /etc/init.d/seatd
  fi

  rc-update add seatd         default
  rc-update add NetworkManager default
  rc-update add bluetooth      default
  rc-update add dbus           default
  rc-update add elogind        default
  rc-update add acpid          default
  rc-update add tlp            default

  # Audio (Cirrus CS4208): the codec boots with Master/Speaker MUTED. Unmute
  # once, then let the alsasound init script restore the state on every boot.
  # Card index for the analog codec is usually 1 (card 0 is HDMI on Haswell).
  ACARD=$(aplay -l 2>/dev/null | sed -n 's/^card \([0-9]\+\): .*\(CS42\|PCH\|Analog\).*/\1/p' | head -1)
  ACARD="${ACARD:-1}"
  for ctl in Master Speaker Headphone "Auto-Mute Mode"; do
    amixer -c "$ACARD" sset "$ctl" unmute 2>/dev/null || true
  done
  amixer -c "$ACARD" sset Master 85% 2>/dev/null || true
  amixer -c "$ACARD" sset Speaker 85% 2>/dev/null || true
  alsactl store 2>/dev/null || true
  rc-update add alsasound boot 2>/dev/null || true

  depmod -a "$(uname -r)"
  mark_step sysconfig
fi

# 11b. SECURITY HARDENING
if ! step_done hardening; then
  header "Applying security hardening..."

  # (1) Kernel cmdline: zero heap on alloc/free — neutralizes most kernel
  #     memory-disclosure bugs. No rebuild needed; effective next boot.
  RL=/boot/refind_linux.conf
  if [[ -f "$RL" ]] && ! grep -q 'init_on_alloc' "$RL"; then
    sed -i '/root=/ s/"[[:space:]]*$/ init_on_alloc=1 init_on_free=1"/' "$RL" || true
    echo "  → added init_on_alloc/init_on_free to $RL"
  else
    echo "  ! $RL missing or already hardened — add 'init_on_alloc=1 init_on_free=1' to your kernel cmdline manually"
  fi

  # (2) sysctl: restrict kernel pointer + dmesg exposure (closes the
  #     kernel-pointer-leak class), plus ptrace scoping.
  cat > /etc/sysctl.d/99-hardening.conf << 'EOF'
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1
kernel.yama.ptrace_scope = 1
EOF
  sysctl --system >/dev/null 2>&1 || true

  # (3) seccomp USE flag — syscall filtering; Brave's sandbox needs it.
  #     Idempotently append to make.conf for already-provisioned systems.
  if ! grep -q 'seccomp' /etc/portage/make.conf; then
    echo 'USE="${USE} seccomp"' >> /etc/portage/make.conf
    echo "  → added seccomp to USE; applied on next @world rebuild"
  fi

  # (4) Kernel .config: zero-on-alloc/free + zero stack variables. Compile-time;
  #     applies the next time the kernel is rebuilt (INIT_STACK_ALL_ZERO has no
  #     cmdline equivalent, so this is the only way to get stack zeroing).
  KSRC=/usr/src/linux
  if [[ -f "$KSRC/Makefile" ]]; then
    "$KSRC"/scripts/config --file "$KSRC/.config" \
      -e CONFIG_INIT_STACK_ALL_ZERO \
      -e CONFIG_INIT_ON_ALLOC_DEFAULT_ON \
      -e CONFIG_INIT_ON_FREE_DEFAULT_ON 2>/dev/null \
      && echo "  → set INIT_STACK_ALL_ZERO / INIT_ON_ALLOC/FREE (applies on next kernel rebuild)" || true
  fi

  mark_step hardening
fi

# 12. BCM5974 TRACKPAD MODULE
if ! step_done bcm5974; then
  header "Building bcm5974 trackpad module..."
  KSRC=/usr/src/linux
  if [[ -f "$KSRC/Makefile" ]]; then
    cd "$KSRC"
    ./scripts/config -m CONFIG_MOUSE_BCM5974
    make olddefconfig
    # Build only the mouse driver directory — fast, no full kernel rebuild needed.
    # Build artifacts from the original kernel compile must be present (they are
    # if the kernel was built in-tree, which gentoo-sources always does).
    make -j3 M=drivers/input/mouse
    make M=drivers/input/mouse modules_install
    depmod -a "$(make -s kernelrelease)"
    # usbmouse can race bcm5974 and steal the trackpad USB interface before
    # bcm5974 loads. Blacklist it — standard USB mice work fine via usbhid.
    echo "blacklist usbmouse" > /etc/modprobe.d/blacklist-usbmouse.conf
    modprobe -r usbmouse 2>/dev/null || true
    modprobe bcm5974 && echo "bcm5974 loaded — trackpad active" || \
      echo "modprobe bcm5974 failed — check dmesg"
    # Auto-load at boot (OpenRC reads /etc/conf.d/modules)
    grep -q bcm5974 /etc/conf.d/modules 2>/dev/null || \
      echo 'modules="${modules} bcm5974"' >> /etc/conf.d/modules
    mark_step bcm5974
  else
    echo "Kernel source not found at $KSRC — skipping"
    echo "Install with: emerge sys-kernel/gentoo-sources && eselect kernel set 1"
  fi
fi

# 12b. VIRTUALIZATION — QEMU/KVM + libvirt
# Non-blocking: a failed emerge here must not skip the dotfiles/kernel steps, and
# the step is only checkpointed on success so a rerun retries cleanly.
if [[ "$INSTALL_VIRT" == "true" ]] && ! step_done virt; then
  header "Installing QEMU/KVM + libvirt..."

  # QEMU needs its target list set, or it builds no system emulators. Append to
  # make.conf idempotently (make_conf step may already be checkpointed).
  grep -q '^QEMU_SOFTMMU_TARGETS' /etc/portage/make.conf || \
    printf 'QEMU_SOFTMMU_TARGETS="x86_64"\nQEMU_USER_TARGETS="x86_64"\n' \
      >> /etc/portage/make.conf
  mkdir -p /etc/portage/package.use
  # USE flags: libvirt needs the qemu driver + its virtual network; qemu wants
  # spice/usbredir for usable desktop VMs and vhost-net for fast guest NICs.
  echo "app-emulation/libvirt qemu virt-network"          > /etc/portage/package.use/libvirt
  echo "app-emulation/qemu spice usbredir vhost-net gtk"  > /etc/portage/package.use/qemu

  if emerge app-emulation/qemu app-emulation/libvirt app-emulation/virt-manager \
            net-misc/bridge-utils; then
    # kvm group owns /dev/kvm; libvirt group lets the user talk to libvirtd.
    groupadd -f kvm; groupadd -f libvirt
    id legend &>/dev/null && usermod -aG kvm,libvirt legend || true
    # OpenRC services (no systemd here): libvirt daemon + default NAT network.
    rc-update add libvirtd default 2>/dev/null || true
    rc-service libvirtd start 2>/dev/null || warn "start libvirtd after reboot"
    if command -v virsh >/dev/null 2>&1; then
      virsh net-autostart default 2>/dev/null || true
      virsh net-start     default 2>/dev/null || true
    fi
    mark_step virt
    echo -e "${GREEN}QEMU/KVM ready — launch virt-manager, or use virsh.${NC}"
  else
    warn "QEMU/libvirt emerge failed — resolve it and rerun setup; continuing."
  fi
fi

# 12c. WAYDROID — Android container. Not packaged in ::gentoo, so build it and
# its gbinder stack from source (libglibutil → libgbinder → gbinder-python →
# waydroid). Every step is guarded so a failure warns instead of aborting setup,
# and the step only checkpoints once `waydroid` is actually on PATH.
if [[ "$INSTALL_WAYDROID" == "true" ]] && ! step_done waydroid; then
  header "Installing Waydroid (from source — not emergeable on Gentoo)..."
  WD_SRC=/usr/local/src
  mkdir -p "$WD_SRC"

  # Deps that ARE in the Gentoo tree. glib + pkgconf are what the gbinder libs
  # compile and advertise themselves against.
  emerge --noreplace app-containers/lxc net-dns/dnsmasq net-firewall/iptables \
    dev-python/pygobject dev-python/dbus-python dev-vcs/git sys-apps/dbus \
    dev-util/gperf sys-devel/gettext dev-libs/glib dev-util/pkgconf \
    || warn "some Waydroid deps failed to emerge — the build may miss something"

  # We install the gbinder stack under LIBDIR=/usr/lib. Make sure pkg-config and
  # the dynamic linker actually look there, or each lib won't find the previous
  # one (libgbinder needs libglibutil's .pc; gbinder-python needs libgbinder's).
  export PKG_CONFIG_PATH="/usr/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
  echo /usr/lib > /etc/ld.so.conf.d/gbinder.conf

  # Clone (shallow) + run a shell build command in the tree. Always returns 0 so
  # a failure just warns — it must NOT abort setup under `set -e`.
  build_git() {  # <name> <url> <shell-build-cmd>
    local name="$1" url="$2" cmd="$3"
    if [[ ! -d "$WD_SRC/$name" ]]; then
      git clone --depth=1 "$url" "$WD_SRC/$name" || { warn "clone $name failed"; return 0; }
    fi
    ( cd "$WD_SRC/$name" && bash -c "$cmd" ) || warn "build/install $name failed"
    return 0
  }

  # gbinder stack. `release` builds the .so, but the mer-hybris Makefiles do NOT
  # list the .pc as a prerequisite of install-dev — so the `pkgconfig` target has
  # to be named explicitly or install-dev dies on `cannot stat build/*.pc`, and
  # without that .pc pkg-config can't find the lib and the NEXT build fails to see
  # its headers. LIBDIR on the build pass so the .pc records /usr/lib. ldconfig
  # (now that /usr/lib is on its path) so the next lib links against this one.
  build_git libglibutil  https://github.com/sailfishos/libglibutil.git \
    'make LIBDIR=/usr/lib release pkgconfig && make LIBDIR=/usr/lib install install-dev'
  ldconfig
  build_git libgbinder   https://github.com/mer-hybris/libgbinder.git \
    'make LIBDIR=/usr/lib release pkgconfig && make LIBDIR=/usr/lib install install-dev'
  ldconfig
  build_git gbinder-python https://github.com/erfanoabdi/gbinder-python.git \
    'python setup.py install'
  build_git waydroid     https://github.com/waydroid/waydroid.git \
    'make install'
  ldconfig
  if command -v waydroid >/dev/null 2>&1 && python -c "import gbinder" 2>/dev/null; then
    # Waydroid ships only systemd units; write a minimal OpenRC init script.
    cat > /etc/init.d/waydroid-container << 'EOF'
#!/sbin/openrc-run
name="waydroid-container"
description="Waydroid Android container manager"
command="/usr/bin/waydroid"
command_args="container start"
command_background="yes"
pidfile="/run/waydroid-container.pid"
depend() { need dbus; }
EOF
    chmod +x /etc/init.d/waydroid-container
    rc-update add waydroid-container default 2>/dev/null || true
    success "Waydroid built. It needs the binder kernel config (this setup enables"
    success "it), so AFTER rebuilding the kernel and rebooting:"
    echo "  doas rc-service waydroid-container start"
    echo "  doas waydroid init          # downloads the Android images (~1 GB)"
    echo "  waydroid session start &     # from inside your niri (Wayland) session"
    echo "  waydroid show-full-ui"
    mark_step waydroid
  else
    warn "Waydroid build didn't complete (waydroid CLI and/or 'import gbinder'"
    warn "missing) — the gbinder stack is fragile. See the warnings above; sources"
    warn "are under $WD_SRC/ for manual fixing, then rerun. Not checkpointed."
    # Not checkpointed — a later rerun retries.
  fi
fi

# 13. REBUILD KERNEL (opt-in) — apply hardened .config (INIT_STACK_ALL_ZERO etc.)
# Gated on the flag, not a checkpoint, so it can be re-triggered on demand.
if [[ "$REBUILD_KERNEL" == "true" ]]; then
  header "Emerging latest 6.18 gentoo-sources + rebuilding kernel..."

  # Sync the portage tree first so the newest 6.18 longterm (6.18.42+) is
  # actually available to emerge — gentoo-sources tracks kernel.org with a lag,
  # so a stale tree would otherwise pull an older 6.18.x.
  echo "  → syncing portage tree (for the freshest 6.18)..."
  emerge-webrsync >/dev/null 2>&1 || emaint sync -a >/dev/null 2>&1 \
    || warn "portage sync failed — will emerge whatever 6.18.x your tree already has"

  # Pull the newest 6.18.x gentoo-sources. This also REPAIRS a corrupt/incomplete
  # tree (the missing-scripts/config symptom) by laying down a clean copy.
  emerge --oneshot "=sys-kernel/gentoo-sources-6.18*" \
    || warn "gentoo-sources 6.18 emerge failed — check ACCEPT_KEYWORDS / portage tree"
  # regulatory.db (real WiFi regdomain for 5 GHz) + genkernel/firmware if missing.
  emerge --noreplace sys-firmware/wireless-regdb sys-kernel/genkernel sys-kernel/linux-firmware 2>/dev/null || true

  # Point /usr/src/linux at the newest 6.18 tree (what eselect kernel set does).
  NEWSRC=$(ls -d /usr/src/linux-6.18.*-gentoo* 2>/dev/null | sort -V | tail -1)
  [[ -n "$NEWSRC" ]] && ln -sfn "$NEWSRC" /usr/src/linux

  KSRC=/usr/src/linux
  if [[ ! -f "$KSRC/Makefile" || ! -x "$KSRC/scripts/config" ]]; then
    echo "  ! Kernel source at $KSRC is still incomplete after emerge — investigate"
    echo "    sys-kernel/gentoo-sources (unmerge + re-emerge, check disk space)."
  else
    cd "$KSRC"
    # A freshly-emerged tree has no .config — seed it from the running kernel so
    # we keep the existing hardware config, then layer our options on top.
    if [[ ! -f .config ]]; then
      if [[ -f /proc/config.gz ]]; then
        zcat /proc/config.gz > .config
      elif ls /boot/config-* >/dev/null 2>&1; then
        cp "$(ls -t /boot/config-* | head -1)" .config
      else
        make defconfig
      fi
    fi
    # Custom kernel identity: gentoo-sources already appends "-gentoo", so this
    # makes uname -r = "<ver>-gentoo-legend" and names the vmlinuz/modules the same
    # (what rEFInd/GRUB show). LOCALVERSION_AUTO off so no git hash is appended.
    ./scripts/config --set-str CONFIG_LOCALVERSION "-legend" \
                     -d CONFIG_LOCALVERSION_AUTO
    # Hardening options (in case the hardening step was skipped).
    ./scripts/config -e CONFIG_INIT_STACK_ALL_ZERO \
                     -e CONFIG_INIT_ON_ALLOC_DEFAULT_ON \
                     -e CONFIG_INIT_ON_FREE_DEFAULT_ON \
                     -m CONFIG_MOUSE_BCM5974
    # BOOT-CRITICAL — applied unconditionally so that even a defconfig-seeded
    # rebuild still boots. Apple EFI display stack (or it boots blind), built-in
    # root drivers (or the initramfs can't mount root), broadcom PREEMPT_NONE (or
    # wl.ko won't build), and IKCONFIG so the NEXT rebuild has /proc/config.gz to
    # re-seed from instead of falling back to defconfig. This is the exact set
    # whose absence produced a boot-blind kernel.
    ./scripts/config -e CONFIG_DRM_I915 -e CONFIG_DRM_SIMPLEDRM \
                     -e CONFIG_DRM_FBDEV_EMULATION -e CONFIG_SYSFB_SIMPLEFB \
                     -e CONFIG_FRAMEBUFFER_CONSOLE \
                     -e CONFIG_EXT4_FS -e CONFIG_BLK_DEV_SD -e CONFIG_SATA_AHCI \
                     -e CONFIG_IKCONFIG -e CONFIG_IKCONFIG_PROC \
                     -d CONFIG_PREEMPT_DYNAMIC -d CONFIG_PREEMPT -e CONFIG_PREEMPT_NONE
    # Removable media: exFAT + FUSE (Ventoy data partition, ntfs-3g, sshfs…).
    ./scripts/config -m CONFIG_EXFAT_FS -m CONFIG_FUSE_FS
    # Virtualisation: KVM + QEMU/libvirt guest networking. VIRTUALIZATION is the
    # parent menu — without it, olddefconfig silently drops KVM.
    ./scripts/config -e CONFIG_VIRTUALIZATION \
                     -e CONFIG_KVM -e CONFIG_KVM_INTEL -e CONFIG_VHOST_NET \
                     -e CONFIG_TUN -e CONFIG_BRIDGE
    # Netfilter/iptables for Waydroid container networking. defconfig omits the
    # legacy ip_tables stack, so waydroid-net.sh fails 'Table does not exist',
    # the container gets no network, and Android never boots.
    ./scripts/config -e CONFIG_NETFILTER -e CONFIG_NETFILTER_ADVANCED -e CONFIG_NETFILTER_XTABLES -e CONFIG_NETFILTER_XTABLES_LEGACY \
                     -e CONFIG_NF_CONNTRACK -e CONFIG_NF_NAT -e CONFIG_NF_TABLES \
                     -e CONFIG_IP_NF_IPTABLES -e CONFIG_IP_NF_FILTER -e CONFIG_IP_NF_NAT \
                     -e CONFIG_IP_NF_MANGLE -e CONFIG_IP_NF_TARGET_MASQUERADE \
                     -e CONFIG_NETFILTER_XT_TARGET_MASQUERADE -e CONFIG_NETFILTER_XT_TARGET_CHECKSUM \
                     -e CONFIG_VETH
    # Waydroid: Android binder container. On 6.x there is no CONFIG_ANDROID menu
    # symbol anymore — BINDER_IPC + BINDERFS (both bool, dep only MMU) are what
    # matter; ashmem is gone, memfd is used. BINDERFS makes the binder/hwbinder/
    # vndbinder nodes dynamically; name them so a non-binderfs fallback still works.
    ./scripts/config -e CONFIG_ANDROID_BINDER_IPC -e CONFIG_ANDROID_BINDERFS \
                     --set-str CONFIG_ANDROID_BINDER_DEVICES "binder,hwbinder,vndbinder"
    # Full hardware + hardening recipe (mirror of install.sh) so a rebuild enables
    # EVERYTHING, not just deltas — Intel ME off, Apple audio/HID/BT/Thunderbolt/
    # USB, broadcom-sta compat (drop in-tree brcm/b43/mac80211), KASLR/PTI/
    # retpoline/lockdown, zswap, and cfg80211 as a MODULE so the kernel can load
    # regulatory.db (5 GHz WiFi needs a real regdomain, not world/00).
    ./scripts/config -d CONFIG_INTEL_MEI -d CONFIG_INTEL_MEI_ME -d CONFIG_INTEL_MEI_TXE \
                     -d CONFIG_INTEL_MEI_HDCP -d CONFIG_INTEL_MEI_PXP
    ./scripts/config -e CONFIG_SND_HDA_CODEC_CIRRUS -e CONFIG_HID_APPLE -e CONFIG_BT_HCIBTUSB \
                     -e CONFIG_X86_INTEL_PSTATE -e CONFIG_THUNDERBOLT \
                     -e CONFIG_USB_XHCI_HCD -e CONFIG_USB_EHCI_HCD
    ./scripts/config -m CONFIG_CFG80211 -e CONFIG_CFG80211_WEXT \
                     -d CONFIG_BRCMSMAC -d CONFIG_BRCMFMAC -d CONFIG_BRCMUTIL \
                     -d CONFIG_B43 -d CONFIG_B43LEGACY -d CONFIG_SSB -d CONFIG_MAC80211
    ./scripts/config -e CONFIG_RANDOMIZE_BASE -e CONFIG_RANDOMIZE_MEMORY \
                     -e CONFIG_PAGE_TABLE_ISOLATION -e CONFIG_MITIGATION_RETPOLINE -e CONFIG_RETPOLINE \
                     -e CONFIG_STRICT_KERNEL_RWX -e CONFIG_STRICT_MODULE_RWX \
                     -e CONFIG_SECURITY_LOCKDOWN_LSM -e CONFIG_SECURITY_LOCKDOWN_LSM_EARLY \
                     -d CONFIG_MODULE_SIG_FORCE
    ./scripts/config -e CONFIG_ZSWAP -e CONFIG_ZSMALLOC -e CONFIG_CRYPTO_LZ4 \
                     -d CONFIG_ZSWAP_COMPRESSOR_DEFAULT_DEFLATE \
                     -e CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4 -e CONFIG_ZSWAP_DEFAULT_ON
    make olddefconfig
    # olddefconfig silently drops any option whose dependency isn't met. Verify
    # the ones we just set survived BEFORE the ~30-min build + reboot, so a missing
    # dep surfaces now instead of at `waydroid init` / first `qemu` run.
    missing=""
    for opt in CONFIG_DRM_SIMPLEDRM CONFIG_SYSFB_SIMPLEFB CONFIG_FRAMEBUFFER_CONSOLE \
               CONFIG_EXT4_FS CONFIG_SATA_AHCI CONFIG_BLK_DEV_SD \
               CONFIG_ANDROID_BINDER_IPC CONFIG_ANDROID_BINDERFS \
               CONFIG_KVM CONFIG_KVM_INTEL CONFIG_VHOST_NET CONFIG_TUN CONFIG_BRIDGE \
               CONFIG_EXFAT_FS CONFIG_FUSE_FS; do
      grep -q "^${opt}=" .config || missing="$missing $opt"
    done
    if [[ -n "$missing" ]]; then
      warn "Kernel options that did NOT stick in .config:$missing"
      warn "The build continues, but features needing them (Waydroid binder, KVM,"
      warn "exFAT…) won't work until you enable them + their deps in 'make menuconfig'."
    else
      success "Verified .config: binder (IPC+BINDERFS), KVM, exFAT/FUSE all set."
    fi
    # Same install path as gentoo/install.sh: make install copies vmlinuz to
    # /boot (rEFInd auto-detects it); genkernel regenerates the initramfs.
    # Guarded so a build failure warns and lets the rest of setup finish (the
    # dotfiles step runs after this) instead of aborting the whole script.
    if make -j3 && make modules_install && make install; then
      if command -v genkernel >/dev/null 2>&1; then
        genkernel --no-clean --no-mrproper --kernel-config="$KSRC/.config" initramfs \
          || warn "genkernel failed — initramfs NOT regenerated; check before reboot"
      else
        echo "  ! genkernel not found — initramfs NOT regenerated; emerge sys-kernel/genkernel and rerun if your boot needs one"
      fi
      # Out-of-tree modules (broadcom-sta wl.ko) must be recompiled against the
      # new kernel or WiFi breaks after reboot. --usepkg=n forces a source build:
      # a stale binpkg is compiled for a different kernel and leaves no wl.ko here.
      emerge --usepkg=n @module-rebuild 2>/dev/null || echo "  ! @module-rebuild failed — rebuild net-wireless/broadcom-sta manually before rebooting"
      NEWVER=$(make -s kernelrelease)
      depmod -a "$NEWVER" 2>/dev/null || true

      # If the version bumped (new 6.18.x), the initramfs filename changed, so
      # rEFInd's initrd= line must point at the new one or boot fails.
      NEWINITRD=$(ls -t /boot/initramfs-*"$NEWVER"*.img 2>/dev/null | head -1)
      if [[ -n "$NEWINITRD" && -f /boot/refind_linux.conf ]]; then
        sed -i "s|initrd=/boot/initramfs-[^ \"]*|initrd=/boot/$(basename "$NEWINITRD")|" \
          /boot/refind_linux.conf \
          && echo "  → refind_linux.conf initrd set to $(basename "$NEWINITRD")"
        # Keep the rEFInd label (first field) = "gentoo <upstream ver> legend".
        NEWBASE=${NEWVER%%-gentoo*}
        sed -i "s|^\"[^\"]*\"|\"gentoo ${NEWBASE} legend\"|" /boot/refind_linux.conf \
          && echo "  → refind_linux.conf label set to 'gentoo ${NEWBASE} legend'"
      fi
      echo -e "${GREEN}Kernel $NEWVER rebuilt. Run 'bash gentoo/troubleshooting/verify-boot'${NC}"
      echo -e "${GREEN}before rebooting into it.${NC}"
    else
      warn "Kernel build failed — the new kernel was NOT installed. Fix the error"
      warn "above and rerun with REBUILD_KERNEL=true. Your current kernel is untouched."
    fi
  fi
fi

# 14. FULL SYSTEM UPDATE (opt-in) — sync + world update + cleanup, all in one.
# This is THE update routine: `REBUILD_WORLD=true doas bash gentoo/setup` does
# everything. Hardened against the two stalls we hit: a perl major bump (needs a
# coordinated rebuild + perl-cleaner) and the kernel-source world entry derailing
# resolution (setup owns the kernel out-of-band, so it must not be a @world member).
if [[ "$REBUILD_WORLD" == "true" ]]; then
  header "Full system update (sync + @world + cleanup — takes hours)..."

  # 1. Sync the tree (webrsync snapshot, fall back to full rsync).
  emerge-webrsync >/dev/null 2>&1 || emaint sync -a >/dev/null 2>&1 \
    || warn "tree sync failed — updating against the on-disk tree."

  # 2. gentoo-sources is managed by the kernel step (--oneshot), not @world.
  # Leaving it in @world makes it an unsatisfiable member that derails the whole
  # resolution, so drop it from the world set (idempotent — no-op if absent).
  emerge --deselect sys-kernel/gentoo-sources >/dev/null 2>&1 || true

  # 3. The update itself. --backtrack=100 gives portage room to solve subslot
  # upgrades (perl, python) it otherwise bails on with the default depth.
  if emerge --update --deep --newuse --with-bdeps=y --backtrack=100 @world; then
    success "@world updated."
  else
    warn "@world update hit a conflict — see the first '!!!' block above. Common"
    warn "cause is a perl bump; the perl-cleaner pass below usually clears it, then"
    warn "rerun: emerge --update --deep --newuse --with-bdeps=y --backtrack=100 @world"
  fi

  # 4. Perl major bumps leave subslot-pinned consumers half-migrated; perl-cleaner
  # rebuilds them against the new perl. No-op when perl didn't move.
  if command -v perl-cleaner >/dev/null 2>&1; then
    perl-cleaner --all 2>/dev/null || warn "perl-cleaner reported errors — check perl consumers."
  fi

  # 5. Out-of-tree modules (broadcom-sta wl.ko) rebuilt against any new kernel ABI,
  # then drop orphaned deps.
  emerge @module-rebuild 2>/dev/null || true
  depmod -a 2>/dev/null || true
  emerge --depclean 2>/dev/null || true
  success "System update complete."
fi

# 15. PORTAGE HOUSEKEEPING — always runs; applies config writes + marks news read
# The `--autounmask-write` emerges above drop ._cfg files under /etc/portage
# (needed USE/keyword changes). Auto-merge *only those* (safe — this script owns
# that dir). Package configs elsewhere in /etc are left for you to review, and
# all repo news is marked read.
header "Portage housekeeping (config merges + news)..."
etc-update --automode -5 /etc/portage >/dev/null 2>&1 || true
eselect news read --all >/dev/null 2>&1 || true
if find /etc -name '._cfg????_*' 2>/dev/null | grep -q .; then
  warn "Config files elsewhere in /etc are pending — review + merge with: doas etc-update"
fi

# ── DOTFILES (always runs — safe to re-run on existing installs) ──────────────
# Guarded with `|| warn`: a network hiccup on git pull must not abort setup
# right before the final instructions, and the symlinks are idempotent.
header "Updating dotfiles..."
if id legend &>/dev/null; then
  su - legend -c '
    if [[ -d ~/legenddots ]]; then
      cd ~/legenddots && git pull --ff-only 2>/dev/null || git pull 2>/dev/null || true
    else
      git clone https://github.com/legendarymsr/legenddots ~/legenddots || true
    fi
    mkdir -p ~/Pictures/Screenshots ~/.config/alacritty ~/.config/niri ~/.config/nvim ~/.config/emacs ~/.local/bin
    ln -sfn ~/legenddots/alacritty.toml  ~/.config/alacritty/alacritty.toml
    ln -sfn ~/legenddots/.zshrc          ~/.zshrc
    ln -sfn ~/legenddots/suckless/screen/screenrc ~/.screenrc
    ln -sfn ~/legenddots/init.lua        ~/.config/nvim/init.lua
    mkdir -p ~/.config/tmux
    ln -sfn ~/legenddots/tmux.conf       ~/.config/tmux/tmux.conf
    ln -sfn ~/legenddots/init.el         ~/.config/emacs/init.el
    ln -sfn ~/legenddots/niri/config.kdl ~/.config/niri/config.kdl
    ln -sfn ~/legenddots/niri/waybar     ~/.config/waybar
    ln -sfn ~/legenddots/niri/fuzzel     ~/.config/fuzzel
    ln -sfn ~/legenddots/niri/dunst      ~/.config/dunst
    ln -sfn ~/legenddots/niri/swaylock   ~/.config/swaylock
    ln -sfn ~/legenddots/wallpapers      ~/.config/wallpapers
    mkdir -p ~/.config/swaybg
    ln -sfn ~/legenddots/wallpapers/6orjlq.jpg ~/.config/swaybg/wallpaper.jpg
  ' || warn "dotfiles update had issues (network?) — symlinks may be partial"
else
  warn "user 'legend' doesn't exist yet — skipping dotfiles (localization/user step must run first)"
fi

echo -e "\n${GREEN}Done.${NC}"
echo ""
echo "Wallpaper and audio start automatically with niri (spawn-at-startup)."
echo "If this is a fresh install, reboot first, then start niri with:"
echo ""
echo "  bash ~/legenddots/gentoo/niri"
