[global]
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    frame_width = 1
    frame_color = "#7aa2f7"

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    timeout = 0
