#!/usr/bin/env bash
# Pre-reboot sanity check after a kernel rebuild. Read-only — changes nothing.
# Run it BEFORE rebooting into a freshly built kernel:
#   bash ~/legenddots/gentoo/verify-boot
#
# It confirms the things that brick a boot when they drift apart:
#   1. A kernel image exists in /boot and was recently built
#   2. rEFInd's initrd= points to an initramfs that actually exists for it
#   3. the out-of-tree WiFi module (wl.ko) is built for that kernel version
#
# This layout uses an UNVERSIONED /boot/vmlinuz (genkernel + make install), so
# the kernel version is read from the image itself with file(1), not the name.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
ok()   { echo -e "${GREEN}  ✓ $*${NC}"; }
warn() { echo -e "${YELLOW}  ! $*${NC}"; }
bad()  { echo -e "${RED}  ✗ $*${NC}"; }
info() { echo -e "${CYAN}$*${NC}"; }

FAIL=0

info "── Kernel image in /boot ──────────────────────────────────────────"
echo "  running now:  $(uname -r)"

# Kernel image: prefer the unversioned /boot/vmlinuz; fall back to versioned.
VM=""
for cand in /boot/vmlinuz /boot/vmlinuz-* /boot/kernel-* /boot/bzImage*; do
  [[ -f "$cand" && "$cand" != *.old ]] && { VM="$cand"; break; }
done
if [[ -z "$VM" ]]; then
  bad "no kernel image found in /boot — nothing to boot into"
  exit 1
fi
echo "  image:        $VM  ($(date -r "$VM" '+%Y-%m-%d %H:%M'))"

# Read the real version string out of the image (filename is unversioned).
NK=$(file "$VM" 2>/dev/null | grep -oE 'version [^ ,]+' | awk '{print $2}')
if [[ -z "$NK" ]]; then
  warn "couldn't parse kernel version from image; falling back to running kernel"
  NK=$(uname -r)
fi
echo "  image version: $NK"
[[ "$NK" == "$(uname -r)" ]] && warn "image version == running kernel (a rebuild of the same version — modules must still match the new build)"

info "\n── initramfs / rEFInd alignment ───────────────────────────────────"
RL=/boot/refind_linux.conf
if [[ ! -f "$RL" ]]; then
  warn "$RL not found — verify your rEFInd boot entry manually"
else
  INITRD_REF=$(grep -o 'initrd=/boot/[^ "]*' "$RL" | head -1 | sed 's|initrd=/boot/||')
  if [[ -z "$INITRD_REF" ]]; then
    warn "no initrd= line in $RL — OK only if the kernel mounts root without an initramfs"
  else
    echo "  refind wants: $INITRD_REF"
    if [[ -f "/boot/$INITRD_REF" ]]; then
      ok "that initramfs exists ($(date -r "/boot/$INITRD_REF" '+%Y-%m-%d %H:%M'))"
      if [[ "$INITRD_REF" == *"$NK"* ]]; then
        ok "initramfs version matches the kernel image ($NK)"
      else
        bad "initramfs '$INITRD_REF' does NOT contain kernel version '$NK' — rEFInd may load a mismatched initramfs"
        FAIL=1
      fi
    else
      bad "refind_linux.conf points to /boot/$INITRD_REF which does NOT exist — boot will fail"
      FAIL=1
    fi
  fi
fi

info "\n── Broadcom WiFi module (wl.ko) for the new kernel ────────────────"
if [[ ! -d "/lib/modules/$NK" ]]; then
  bad "/lib/modules/$NK missing — 'make modules_install' didn't run for this kernel"
  FAIL=1
elif modinfo -k "$NK" wl >/dev/null 2>&1; then
  ok "wl.ko is built for $NK — WiFi will work"
else
  bad "wl.ko MISSING for $NK — WiFi will break after reboot"
  warn "  fix before reboot: emerge @module-rebuild && depmod -a $NK"
  FAIL=1
fi

info "\n── Hardening cmdline (informational) ──────────────────────────────"
if grep -q 'init_on_alloc' "$RL" 2>/dev/null; then
  ok "init_on_alloc/init_on_free present on the kernel cmdline"
else
  warn "init_on_alloc not on cmdline in $RL (harmless if built into the kernel .config)"
fi

info "\n── Fallback kernel ────────────────────────────────────────────────"
if [[ -f /boot/vmlinuz.old ]]; then
  ok "vmlinuz.old present — you can boot the previous kernel if the new one fails"
else
  warn "no vmlinuz.old — no automatic fallback to the previous kernel"
fi

echo
if [[ "$FAIL" -eq 0 ]]; then
  echo -e "${GREEN}All critical checks passed — safe to reboot into $NK.${NC}"
else
  echo -e "${RED}One or more critical checks FAILED — do NOT reboot until fixed (see ✗ lines above).${NC}"
  exit 1
fi
