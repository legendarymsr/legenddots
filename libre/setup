# ── GNU Shepherd init (replaces SysVinit) ─────────────────────────────────────
# Shepherd is written in Guile Scheme, so we bootstrap the whole GNU stack:
# libatomic_ops → bdw-gc → libunistring → Guile → Shepherd. gmp and libffi are
# already built above (needed by GCC and the general system).
pkg libatomic_ops_f "$SRC/libatomic_ops-7.8.2.tar.gz" bash -c "
  ./configure --prefix=/usr --enable-shared --disable-static
  make \$MAKEFLAGS && make install
"
pkg bdwgc_f "$SRC/gc-8.2.8.tar.gz" bash -c "
  ./configure --prefix=/usr --enable-cplusplus --disable-static \
    --enable-large-config
  make \$MAKEFLAGS && make install
"
pkg libunistring_f "$SRC/libunistring-1.3.tar.xz" bash -c "
  ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/libunistring-1.3
  make \$MAKEFLAGS && make install
"
pkg guile_f "$SRC/guile-3.0.10.tar.xz" bash -c "
  ./configure --prefix=/usr --disable-static \
    --docdir=/usr/share/doc/guile-3.0.10
  make \$MAKEFLAGS && make install
  find /usr/lib /usr/libexec -name '*.la' -delete 2>/dev/null || true
"
pkg shepherd_f "$SRC/shepherd-0.10.7.tar.gz" bash -c "
  ./configure --prefix=/usr --localstatedir=/var
  make \$MAKEFLAGS && make install
"

# ── System configuration ───────────────────────────────────────────────────────
if ! done sysconfig; then
  echo "==> System configuration"
  ROOT_UUID=$(blkid -s UUID -o value $ROOT 2>/dev/null || echo "CHANGEME")
  EFI_UUID=$(blkid  -s UUID -o value $EFI  2>/dev/null || echo "CHANGEME")
  SWAP_UUID=$(blkid -s UUID -o value $SWAP 2>/dev/null || echo "CHANGEME")

  cat > /etc/fstab << EOF2
UUID=$ROOT_UUID  /         ext4  defaults,noatime 0 1
UUID=$EFI_UUID   /boot/efi vfat  umask=0077       0 2
UUID=$SWAP_UUID  none      swap  sw               0 0
tmpfs            /tmp      tmpfs defaults          0 0
EOF2

  echo "guixless" > /etc/hostname

  # ── GNU Shepherd as PID 1 ───────────────────────────────────────────────────
  # The kernel execs /sbin/init; we make that a thin wrapper that hands control
  # to Shepherd, which reads its service graph from /etc/shepherd/init.scm.
  cat > /sbin/init << 'EOF2'
#!/bin/sh
exec /usr/bin/shepherd --config /etc/shepherd/init.scm
EOF2
  chmod 755 /sbin/init

  mkdir -pv /etc/shepherd
  cat > /etc/shepherd/init.scm << 'EOF2'
;; GNU Shepherd PID-1 configuration — GNU/Linux-libre From Scratch
(use-modules (shepherd service)
             (oop goops))

;; Bring up early boot: pseudo-filesystems, remount root rw, swap, hostname.
(define sysinit
  (make <service>
    #:provides '(sysinit)
    #:respawn? #f
    #:start (lambda _
              (system "/usr/bin/mount -n -t proc     proc     /proc")
              (system "/usr/bin/mount -n -t sysfs    sysfs    /sys")
              (system "/usr/bin/mount -n -t devtmpfs devtmpfs /dev")
              (system "/usr/bin/mount -n -t tmpfs    tmpfs    /run")
              (system "/usr/bin/mount -o remount,rw /")
              (system "/usr/sbin/swapon -a")
              (system "/usr/bin/hostname -F /etc/hostname")
              (system "/usr/sbin/udevd --daemon")
              (system "/usr/bin/udevadm trigger --action=add")
              #t)
    #:stop (const #f)))

;; A getty on tty1..tty3 so you can log in on the console.
(define (getty tty)
  (make <service>
    #:provides (list (string->symbol (string-append "getty-" tty)))
    #:requires '(sysinit)
    #:respawn? #t
    #:start (make-forkexec-constructor
             (list "/sbin/agetty" "--noclear" tty "38400" "linux"))
    #:stop  (make-kill-destructor)))

(register-services
 (list sysinit
       (getty "tty1") (getty "tty2") (getty "tty3")))

(action 'shepherd 'daemonize)
(for-each start-service (list sysinit))
(for-each start-in-the-background
          '(getty-tty1 getty-tty2 getty-tty3))
EOF2

  mkdir -pv /etc/profile.d
  cat > /etc/profile << 'EOF2'
for script in /etc/profile.d/*.sh; do
  [ -r "$script" ] && . "$script"
done
unset script
EOF2

  cat > /etc/profile.d/locale.sh << 'EOF2'
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
EOF2

  cat > /etc/inputrc << 'EOF2'
set horizontal-scroll-mode Off
set meta-flag On
set input-meta On
set convert-meta Off
set output-meta On
set bell-style none
"\eOd": backward-word
"\eOc": forward-word
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[3~": delete-char
"\e[2~": quoted-insert
EOF2

  cat > /etc/shells << 'EOF2'
/bin/sh
/bin/bash
EOF2

  echo 'root:legendary123' | chpasswd
  mark sysconfig
fi

# ── Kernel ────────────────────────────────────────────────────────────────────
if ! done kernel; then
  echo "==> Linux-libre 6.16 (KVM/QEMU, x86_64, deblobbed)"
  bpkg "$SRC/linux-libre-6.16-gnu.tar.xz" bash -c "
    make defconfig
    # Linux-libre ships with CONFIG_STANDALONE=y and no in-tree blobs; keep
    # firmware loading off so nothing pulls a nonfree blob at build or runtime.
    ./scripts/config -d CONFIG_FW_LOADER_USER_HELPER -e CONFIG_STANDALONE
    ./scripts/config \
      -e CONFIG_VIRTIO_PCI -e CONFIG_VIRTIO_BLK -e CONFIG_VIRTIO_NET \
      -e CONFIG_VIRTIO_MMIO -e CONFIG_DRM_VIRTIO_GPU \
      -e CONFIG_HW_RANDOM_VIRTIO -e CONFIG_VIRTIO_BALLOON \
      -e CONFIG_VIRTIO_INPUT -e CONFIG_VIRTIO_CONSOLE \
      -e CONFIG_9P_FS -e CONFIG_9P_FS_POSIX_ACL \
      -e CONFIG_NET_9P -e CONFIG_NET_9P_VIRTIO \
      -e CONFIG_USB_NET_CDC_ETHER -e CONFIG_USB_NET_RNDIS_HOST \
      -e CONFIG_EXT4_FS -e CONFIG_VFAT_FS -e CONFIG_NLS_UTF8 \
      -e CONFIG_TMPFS -e CONFIG_DRM -e CONFIG_DRM_KMS_HELPER \
      -e CONFIG_FB_EFI -e CONFIG_ACPI -e CONFIG_MAGIC_SYSRQ \
      -e CONFIG_RANDOMIZE_BASE -e CONFIG_RANDOMIZE_MEMORY \
      -e CONFIG_PAGE_TABLE_ISOLATION -e CONFIG_RETPOLINE \
      -e CONFIG_STRICT_KERNEL_RWX -e CONFIG_STRICT_MODULE_RWX \
      -e CONFIG_ZSWAP -e CONFIG_ZSWAP_DEFAULT_ON \
      -d CONFIG_INTEL_MEI -d CONFIG_INTEL_MEI_ME
    make olddefconfig
    make -j2
    make modules_install
    cp -v arch/x86/boot/bzImage /boot/vmlinuz-6.16-libre
    cp -v System.map /boot/System.map-6.16-libre
    cp -v .config /boot/config-6.16-libre
  "
  mark kernel
fi

# ── BLFS prerequisites ────────────────────────────────────────────────────────
pkg wget_f    "$SRC/wget-1.24.5.tar.gz"       bash -c "./configure --prefix=/usr --sysconfdir=/etc --with-ssl=openssl; make \$MAKEFLAGS; make install"
pkg curl_f    "$SRC/curl-8.9.1.tar.xz"        bash -c "./configure --prefix=/usr --disable-static --with-openssl --enable-threaded-resolver; make \$MAKEFLAGS; make install"
