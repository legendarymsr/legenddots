#!/usr/bin/env bash
# =============================================================================
# rebuild-kernel — rebuild the kernel from the PROVEN, bootable config.
# -----------------------------------------------------------------------------
# Use this when the kernel won't boot — especially when it hangs at rEFInd's
# "Starting vmlinuz" with no output (a REBUILD_KERNEL that fell back to bare
# `make defconfig` and dropped the Apple EFI display stack + built-in root
# drivers, so the machine boots blind / can't mount root).
#
# It reproduces install.sh's kernel recipe EXACTLY: `make defconfig` + every
# hardware/hardening/driver tweak (simpledrm + framebuffer console for the Mac
# display, ext4/ahci/sd built-in, broadcom PREEMPT_NONE, MEI removal, KVM,
# binder, zswap, KASLR…), then builds, installs, regenerates the initramfs, and
# repoints rEFInd.
#
# Run as root INSIDE the Gentoo system (booted, or chrooted from a live USB):
#   bash rebuild-kernel
# =============================================================================
set -o pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
header()  { echo -e "\n\033[1m\033[36m── $* \033[0m"; }
warn()    { echo -e "${YELLOW}  ! $*${NC}"; }
success() { echo -e "${GREEN}  ✓ $*${NC}"; }
die()     { echo -e "${RED}  ✗ $*${NC}"; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root: bash rebuild-kernel"
command -v emerge >/dev/null 2>&1 || die "no emerge — run this inside the Gentoo system (chroot in first)."
source /etc/profile 2>/dev/null || true

# Which kernel series to build. Default 6.18 (the longterm this system targets).
# MUST be pinned — an unpinned `emerge gentoo-sources` now grabs the 7.x series,
# which broadcom-sta's wl.ko doesn't build against and nothing else here expects.
KSERIES="${KSERIES:-6.18}"

header "Ensuring ${KSERIES} kernel sources are present..."
# A COMPLETE tree = has Makefile + scripts/config. A past depclean can leave a
# gutted dir (build artifacts remain, but the portage-owned source is deleted),
# so checking the directory exists is NOT enough — check for the real source.
newest_complete() {
  local d best=""
  for d in $(ls -d /usr/src/linux-${KSERIES}* 2>/dev/null | sort -V); do
    [[ -f "$d/Makefile" && -x "$d/scripts/config" ]] && best="$d"
  done
  [[ -n "$best" ]] && echo "$best"
}
if [[ -z "$(newest_complete)" ]]; then
  warn "no complete ${KSERIES} source tree — removing any gutted leftover + re-emerging..."
  rm -rf /usr/src/linux-${KSERIES}*    # clear a depclean-gutted dir so it extracts clean
  emerge "=sys-kernel/gentoo-sources-${KSERIES}*" || die "gentoo-sources ${KSERIES} emerge failed (check ACCEPT_KEYWORDS)"
fi
command -v genkernel >/dev/null 2>&1 || emerge sys-kernel/genkernel sys-kernel/linux-firmware || warn "genkernel/firmware emerge issue"
# Point /usr/src/linux at the newest COMPLETE ${KSERIES} tree — not a newer series.
NEWEST=$(newest_complete)
[[ -n "$NEWEST" ]] || die "still no complete ${KSERIES} source tree after emerge"
ln -sfn "$NEWEST" /usr/src/linux
cd "$NEWEST" || die "cd $NEWEST failed"
success "building from $NEWEST"

header "Seeding defconfig + applying the proven MBA 6,2 config..."
make defconfig

# --- CUSTOM KERNEL IDENTITY ---
# gentoo-sources appends "-gentoo"; add "-legend" -> uname "<ver>-gentoo-legend"
# (and vmlinuz/modules named to match, which is what rEFInd/GRUB display).
./scripts/config --set-str CONFIG_LOCALVERSION "-legend"
./scripts/config -d CONFIG_LOCALVERSION_AUTO

# --- INTEL ME REMOVAL ---
./scripts/config -d CONFIG_INTEL_MEI
./scripts/config -d CONFIG_INTEL_MEI_ME
./scripts/config -d CONFIG_INTEL_MEI_TXE
./scripts/config -d CONFIG_INTEL_MEI_HDCP
./scripts/config -d CONFIG_INTEL_MEI_PXP

# --- MBA 6,2 HARDWARE (incl. the Apple EFI display stack — the boot-blind fix) ---
./scripts/config -e CONFIG_DRM_I915
./scripts/config -e CONFIG_DRM_SIMPLEDRM
./scripts/config -e CONFIG_DRM_FBDEV_EMULATION
./scripts/config -e CONFIG_SYSFB_SIMPLEFB
./scripts/config -e CONFIG_FRAMEBUFFER_CONSOLE
./scripts/config -e CONFIG_SND_HDA_CODEC_CIRRUS
./scripts/config -e CONFIG_HID_APPLE
./scripts/config -m CONFIG_MOUSE_BCM5974
./scripts/config -e CONFIG_BT_HCIBTUSB
./scripts/config -e CONFIG_SATA_AHCI
./scripts/config -e CONFIG_X86_INTEL_PSTATE
./scripts/config -e CONFIG_THUNDERBOLT
./scripts/config -e CONFIG_USB_XHCI_HCD
./scripts/config -e CONFIG_USB_EHCI_HCD
# ext4 + SCSI disk built-in so the initramfs can mount root with no modules.
./scripts/config -e CONFIG_EXT4_FS
./scripts/config -e CONFIG_BLK_DEV_SD

# --- IN-KERNEL CONFIG (/proc/config.gz) — so a future rebuild can re-seed from
# the running config instead of falling back to boot-blind `make defconfig`. ---
./scripts/config -e CONFIG_IKCONFIG
./scripts/config -e CONFIG_IKCONFIG_PROC

# --- REMOVABLE MEDIA: exFAT + FUSE ---
./scripts/config -m CONFIG_EXFAT_FS
./scripts/config -m CONFIG_FUSE_FS

# --- VIRTUALISATION: KVM + networking for QEMU/libvirt ---
./scripts/config -e CONFIG_VIRTUALIZATION
./scripts/config -e CONFIG_KVM
./scripts/config -e CONFIG_KVM_INTEL
./scripts/config -e CONFIG_VHOST_NET
./scripts/config -e CONFIG_TUN
./scripts/config -e CONFIG_BRIDGE

# --- NETFILTER / iptables (Waydroid container networking) ---
# waydroid-net.sh sets up a bridge + iptables NAT/filter/mangle. defconfig omits
# the legacy ip_tables stack, so without these 'iptables' fails with 'Table does
# not exist', the container gets no network, and Android never boots.
./scripts/config -e CONFIG_NETFILTER -e CONFIG_NETFILTER_ADVANCED -e CONFIG_NETFILTER_XTABLES -e CONFIG_NETFILTER_XTABLES_LEGACY
./scripts/config -e CONFIG_NF_CONNTRACK -e CONFIG_NF_NAT -e CONFIG_NF_TABLES
./scripts/config -e CONFIG_IP_NF_IPTABLES -e CONFIG_IP_NF_FILTER -e CONFIG_IP_NF_NAT \
                 -e CONFIG_IP_NF_MANGLE -e CONFIG_IP_NF_TARGET_MASQUERADE
./scripts/config -e CONFIG_NETFILTER_XT_TARGET_MASQUERADE \
                 -e CONFIG_NETFILTER_XT_TARGET_CHECKSUM \
                 -e CONFIG_NETFILTER_XT_MATCH_CONNTRACK \
                 -e CONFIG_NETFILTER_XT_MATCH_COMMENT
./scripts/config -e CONFIG_VETH

# --- WAYDROID: Android container (binder) ---
./scripts/config -e CONFIG_ANDROID_BINDER_IPC
./scripts/config -e CONFIG_ANDROID_BINDERFS
./scripts/config --set-str CONFIG_ANDROID_BINDER_DEVICES "binder,hwbinder,vndbinder"
# Waydroid's LXC container + Android userspace also need: user namespaces + the
# device cgroup (LXC), a loop device (to mount system/vendor .img), PSI (lmkd),
# and dma-buf sync/heaps (graphics). Without these the container won't start or
# Android boots to a black screen. defconfig leaves several off.
./scripts/config -e CONFIG_USER_NS
./scripts/config -e CONFIG_BLK_DEV_LOOP
./scripts/config -e CONFIG_CGROUP_DEVICE
./scripts/config -e CONFIG_PSI
./scripts/config -e CONFIG_SYNC_FILE
./scripts/config -e CONFIG_DMABUF_HEAPS
./scripts/config -e CONFIG_DMABUF_HEAPS_SYSTEM
# LXC's recommended-kernel notice: MEMCG (container memory cgroup — usually already
# on) and MACVLAN (an LXC networking mode; Waydroid uses bridge+veth+NAT, not this,
# but set it to satisfy the notice).
./scripts/config -e CONFIG_MEMCG
./scripts/config -m CONFIG_MACVLAN

# --- WIRELESS: cfg80211 as a MODULE so the kernel can load regulatory.db from
# /lib/firmware — needed for a real regdomain (5 GHz WiFi; world/00 blocks it). ---
./scripts/config -m CONFIG_CFG80211 -e CONFIG_CFG80211_WEXT

# --- BROADCOM-STA (wl) COMPATIBILITY ---
./scripts/config -d CONFIG_PREEMPT_DYNAMIC
./scripts/config -d CONFIG_PREEMPT
./scripts/config -e CONFIG_PREEMPT_NONE
./scripts/config -d CONFIG_BRCMSMAC
./scripts/config -d CONFIG_BRCMFMAC
./scripts/config -d CONFIG_BRCMUTIL
./scripts/config -d CONFIG_B43
./scripts/config -d CONFIG_B43LEGACY
./scripts/config -d CONFIG_SSB
./scripts/config -d CONFIG_MAC80211

# --- HARDENED SECURITY ---
./scripts/config -e CONFIG_RANDOMIZE_BASE
./scripts/config -e CONFIG_RANDOMIZE_MEMORY
./scripts/config -e CONFIG_PAGE_TABLE_ISOLATION
./scripts/config -e CONFIG_MITIGATION_RETPOLINE
./scripts/config -e CONFIG_RETPOLINE
./scripts/config -e CONFIG_STRICT_KERNEL_RWX
./scripts/config -e CONFIG_STRICT_MODULE_RWX
./scripts/config -e CONFIG_SECURITY_LOCKDOWN_LSM
./scripts/config -e CONFIG_SECURITY_LOCKDOWN_LSM_EARLY
./scripts/config -d CONFIG_MODULE_SIG_FORCE
./scripts/config -e CONFIG_INIT_STACK_ALL_ZERO
./scripts/config -e CONFIG_INIT_ON_ALLOC_DEFAULT_ON
./scripts/config -e CONFIG_INIT_ON_FREE_DEFAULT_ON

# --- ZSWAP ---
./scripts/config -e CONFIG_ZSWAP
./scripts/config -e CONFIG_ZSMALLOC
./scripts/config -e CONFIG_CRYPTO_LZ4
./scripts/config -d CONFIG_ZSWAP_COMPRESSOR_DEFAULT_DEFLATE
./scripts/config -e CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4
./scripts/config -e CONFIG_ZSWAP_DEFAULT_ON

make olddefconfig

# Verify the boot-critical options actually stuck BEFORE the long build.
header "Verifying boot-critical options survived olddefconfig..."
missing=""
for opt in CONFIG_DRM_SIMPLEDRM CONFIG_SYSFB_SIMPLEFB CONFIG_FRAMEBUFFER_CONSOLE \
           CONFIG_EXT4_FS CONFIG_SATA_AHCI CONFIG_BLK_DEV_SD \
           CONFIG_KVM CONFIG_KVM_INTEL CONFIG_ANDROID_BINDER_IPC CONFIG_ANDROID_BINDERFS \
           CONFIG_USER_NS CONFIG_BLK_DEV_LOOP CONFIG_CGROUP_DEVICE; do
  grep -q "^${opt}=y" .config || missing="$missing $opt"
done
if [[ -n "$missing" ]]; then
  warn "Options that did NOT stick as =y:$missing"
  warn "  DRM/EXT4/AHCI/SD are boot-critical (blind boot / can't mount root)."
  warn "  KVM/binder/USER_NS/LOOP/CGROUP_DEVICE break QEMU-KVM / Waydroid instead."
  warn "Continuing — enable the missing symbol + its deps in 'make menuconfig' if needed."
else
  success "Display + root drivers AND KVM/binder/container options are all =y. Good."
fi

header "Building kernel (make -j3)..."
make -j3 && make modules_install && make install || die "kernel build/install failed — fix the error above."

header "Regenerating initramfs + out-of-tree modules..."
genkernel --no-clean --no-mrproper --kernel-config=/usr/src/linux/.config initramfs \
  || warn "genkernel failed — initramfs NOT regenerated; do NOT reboot until fixed."
# --usepkg=n: a stale binpkg of broadcom-sta is built for a DIFFERENT kernel, so
# using it leaves no wl.ko for this one. Force a source compile against /usr/src/linux.
emerge --usepkg=n @module-rebuild 2>/dev/null || warn "@module-rebuild failed — rebuild net-wireless/broadcom-sta."
KVER=$(make -s kernelrelease)
depmod -a "$KVER" 2>/dev/null || true

# Repoint rEFInd's initrd= at the (possibly renamed) initramfs.
NEWINITRD=$(ls -t /boot/initramfs-*"$KVER"*.img 2>/dev/null | head -1)
if [[ -n "$NEWINITRD" && -f /boot/refind_linux.conf ]]; then
  sed -i "s|initrd=/boot/initramfs-[^ \"]*|initrd=/boot/$(basename "$NEWINITRD")|" \
    /boot/refind_linux.conf && success "refind_linux.conf initrd -> $(basename "$NEWINITRD")"
fi

# verify-boot from wherever the repo lives
for p in /root/legenddots /home/legend/legenddots /legenddots; do
  [[ -f "$p/gentoo/troubleshooting/verify-boot" ]] && { header "verify-boot"; bash "$p/gentoo/troubleshooting/verify-boot" || true; break; }
done

header "Done."
success "Kernel ${KVER} rebuilt from the proven config. Exit the chroot, umount, reboot."
