#!/bin/sh
# ~/.config/bspwm/bspwmrc — legenddots (minimal)
# bspwm does nothing on its own; this script configures it and starts the bits
# around it. sxhkd owns the keybinds (see sxhkdrc). No recompiling, ever.

sxhkd &                               # keybind daemon (reads ~/.config/sxhkd/sxhkdrc)
picom &                               # compositor
dunst &                               # notifications
setxkbmap se                          # keyboard layout — change to yours
"$HOME/.config/polybar/launch.sh" &   # the bar: ram · battery · date

bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width          2
bspc config window_gap            6
bspc config normal_border_color   "#1a1b26"
bspc config focused_border_color  "#7aa2f7"
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true
