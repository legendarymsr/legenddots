! ~/.Xresources — Tokyo Night for xterm (runtime config; no config.h, no rebuild).
! Loaded by ~/.xinitrc via `xrdb -merge`. This is st's config.h, moved to a
! runtime dotfile so it fits a slow RISC-V board.

xterm*faceName:    JetBrainsMono Nerd Font
xterm*faceSize:    11
xterm*termName:    xterm-256color
xterm*saveLines:   8192
xterm*scrollBar:   false
xterm*metaSendsEscape: true
xterm*selectToClipboard: true

! Tokyo Night palette
xterm*background:  #1a1b26
xterm*foreground:  #c0caf5
xterm*cursorColor: #c0caf5
