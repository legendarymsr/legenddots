. /lib/lsb/init-functions

case "${1}" in
   start)
      log_info_msg "Starting wifi on wlan0..."
      modprobe wl 2>/dev/null
      i=0
      while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
      if [ ! -e /sys/class/net/wlan0 ]; then
         log_failure_msg2
         exit 0
      fi
      ip link set wlan0 up
      /usr/sbin/wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant-wlan0.conf -P /run/wpa_supplicant-wlan0.pid
      /usr/sbin/dhcpcd -b wlan0
      evaluate_retval
      ;;
   stop)
