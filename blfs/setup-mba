#!/usr/bin/env bash
# =============================================================================
# LFS 12.4 + BLFS Desktop Setup — MacBook Air 6,2 (Yuki) / Niri + Wayland
#
# Installs LFS next to an existing system (Gentoo). It never touches the
# partition table: it only uses partitions that already exist.
#
# Run on the Gentoo host, as root:
#   LFS_PART=/dev/sda5 LFS_ESP=/dev/sda1 bash ~/legenddots/blfs/setup-mba
#
#   LFS_PART            free/empty partition for the LFS root (>= 40 GiB)
#   LFS_ESP             the existing EFI System Partition (never formatted)
#   LFS_SWAP            optional swap partition (default: 4 GiB /swapfile)
#   LFS_CONFIRM_FORMAT  partition(s) that already hold a filesystem and may be
#                       reformatted (space separated, must match exactly)
#   LFS_DESKTOP=no      stop after the LFS base system (skip the desktop)
#   LFS_WIFI_SSID / LFS_WIFI_PSK   optional, written to wpa_supplicant.conf
#
# Phase 1 (Gentoo host): checks the partitions, builds LFS 12.4, builds the
#   kernel and the Broadcom wl driver, adds an LFS entry to the existing rEFInd
#   config. It then runs Phase 2 inside the chroot with the host's network.
# Phase 2 (chroot or the booted LFS): builds the Niri + Wayland desktop.
#   Re-run the same command to resume; every step is checkpointed.
#
# Checkpoint files:
#   /var/log/lfs-host.state   — Phase 1 host steps (on Gentoo)
#   /etc/blfs-setup.state     — Phase 2 BLFS steps (in LFS)
#   (lfs_complete marker in /etc/blfs-setup.state separates the two phases)
# =============================================================================
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root"; exit 1; }

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[0;33m'; NC='\033[0m'
header() { echo -e "\n\033[1m\033[36m── $* ──\033[0m"; }
info()   { echo -e "${CYAN}  → $*${NC}"; }
ok()     { echo -e "${GREEN}  ✓ $*${NC}"; }
warn()   { echo -e "${YELLOW}  ! $*${NC}"; }
die()    { echo -e "${RED}  ✗ $*${NC}" >&2; exit 1; }

# =============================================================================
# PHASE DETECTION
# =============================================================================
LFS=/mnt/lfs
SELF=$(readlink -f "${BASH_SOURCE[0]}")

if grep -qx "lfs_complete" /etc/blfs-setup.state 2>/dev/null && [[ -e /etc/lfs-release ]]; then
    LFS_DONE=true
else
    LFS_DONE=false
fi

# =============================================================================
# PHASE 1 — LFS BASE SYSTEM (run from Gentoo host)
# =============================================================================
if [[ "$LFS_DONE" == false ]]; then

LFS_TGT="x86_64-lfs-linux-gnu"
MAKEFLAGS="${MAKEFLAGS:--j3}"
LFS_PART="${LFS_PART:-}"
LFS_ESP="${LFS_ESP:-}"
LFS_SWAP="${LFS_SWAP:-}"
LFS_CONFIRM_FORMAT="${LFS_CONFIRM_FORMAT:-}"

HOST_STATE=/var/log/lfs-host.state
touch "$HOST_STATE"
step_done() { grep -qx "$1" "$HOST_STATE"; }
mark_step()  { echo "$1" >> "$HOST_STATE"; }

# ── Host validation ──────────────────────────────────────────────────────────
header "Validating host"

declare -A HOST_PKGS=(
  [gcc]="sys-devel/gcc"
  [g++]="sys-devel/gcc"
  [make]="sys-devel/make"
  [bison]="sys-devel/bison"
  [flex]="sys-devel/flex"
  [gawk]="sys-apps/gawk"
  [grep]="sys-apps/grep"
  [gzip]="app-arch/gzip"
  [m4]="sys-devel/m4"
  [perl]="dev-lang/perl"
  [python3]="dev-lang/python"
  [tar]="app-arch/tar"
  [xz]="app-arch/xz-utils"
  [patch]="sys-devel/patch"
  [sed]="sys-apps/sed"
  [diff]="sys-apps/diffutils"
  [find]="sys-apps/findutils"
  [makeinfo]="sys-apps/texinfo"
  [mkswap]="sys-apps/util-linux"
  [lsblk]="sys-apps/util-linux"
  [findmnt]="sys-apps/util-linux"
  [blkid]="sys-apps/util-linux"
  [mke2fs]="sys-fs/e2fsprogs"
)
missing=()
for cmd in "${!HOST_PKGS[@]}"; do
  command -v "$cmd" &>/dev/null || missing+=("${HOST_PKGS[$cmd]}")
done
if (( ${#missing[@]} )); then
  mapfile -t missing < <(printf '%s\n' "${missing[@]}" | sort -u)
  die "Missing host tools. Run: emerge -av ${missing[*]}"
fi

if command -v wget &>/dev/null; then
  dl() { wget -q --show-progress -c -O "$1" "$2"; }
elif command -v curl &>/dev/null; then
  dl() { curl -fL --progress-bar -C - -o "$1" "$2"; }
else
  die "Neither wget nor curl found — emerge net-misc/wget"
fi

[[ $(gcc -dumpmachine) == x86_64* ]] || die "Host must be x86_64"
[[ $(readlink -f /bin/sh) == */bash ]] || die "/bin/sh must be bash (LFS host requirement)"
python3 -c 'import sys; assert sys.version_info >= (3,4)' 2>/dev/null \
  || die "python3 >= 3.4 required"
awk --version 2>&1 | grep -q "GNU Awk" || die "gawk (GNU Awk) required — not mawk/nawk"
[[ -r /etc/resolv.conf ]] || die "/etc/resolv.conf missing on the host"
info "Host OK"

# ── Partitions (existing only — the partition table is never modified) ───────
if ! step_done disk; then
  header "Checking partitions"
  if [[ -z "$LFS_PART" || -z "$LFS_ESP" ]]; then
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,PARTTYPENAME,MOUNTPOINTS >&2
    die "Usage: LFS_PART=/dev/sdXN LFS_ESP=/dev/sdXM [LFS_SWAP=/dev/sdXK] bash $0"
  fi

  RESULT=""
  part_check() {
    local d; d=$(readlink -f "$1")
    [[ -b "$d" ]] || die "$1 is not a block device"
    [[ "$(lsblk -dno TYPE "$d")" == part ]] \
      || die "$1 is not a partition — whole disks are refused"
    if [[ "${2:-}" != mounted-ok ]]; then
      if findmnt -rn -S "$d" >/dev/null 2>&1; then die "$1 is mounted — unmount it first"; fi
      if grep -q "^${d}[[:space:]]" /proc/swaps; then die "$1 is active swap — swapoff it first"; fi
    fi
    RESULT="$d"
  }
  part_check "$LFS_PART";               ROOT="$RESULT"
  part_check "$LFS_ESP" mounted-ok;     EFI="$RESULT"
  SWAP=""
  if [[ -n "$LFS_SWAP" ]]; then part_check "$LFS_SWAP"; SWAP="$RESULT"; fi
  [[ "$ROOT" != "$EFI" && ( -z "$SWAP" || ( "$SWAP" != "$ROOT" && "$SWAP" != "$EFI" ) ) ]] \
    || die "LFS_PART, LFS_ESP and LFS_SWAP must be three different partitions"

  host_root=$(readlink -f "$(findmnt -no SOURCE /)")
  [[ "$ROOT" != "$host_root" ]] || die "$ROOT is the running host's root partition"

  esp_type=$(blkid -p -s PART_ENTRY_TYPE -o value "$EFI" 2>/dev/null || true)
  [[ "${esp_type,,}" == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ]] \
    || die "$EFI is not an EFI System Partition (type GUID $esp_type)"
  [[ "$(blkid -p -s TYPE -o value "$EFI" 2>/dev/null || true)" == vfat ]] \
    || die "$EFI is not FAT — refusing to use it as the ESP"

  root_bytes=$(lsblk -bdno SIZE "$ROOT")
  if (( root_bytes < 40 * 1024 * 1024 * 1024 )) && [[ "${LFS_ALLOW_SMALL:-no}" != yes ]]; then
    die "$ROOT is smaller than 40 GiB (LLVM + Rust + kernel need ~35 GiB). Set LFS_ALLOW_SMALL=yes to override"
  fi

  confirmed() { [[ " $LFS_CONFIRM_FORMAT " == *" $1 "* ]]; }
  root_fs=$(blkid -p -s TYPE -o value "$ROOT" 2>/dev/null || true)
  root_label=$(blkid -p -s LABEL -o value "$ROOT" 2>/dev/null || true)
  MKFS_ROOT=yes
  if [[ -z "$root_fs" ]]; then
    :
  elif [[ "$root_fs" == ext4 && "$root_label" == LFS ]]; then
    MKFS_ROOT=no
    info "$ROOT is already an ext4 filesystem labelled LFS — reusing it"
  else
    confirmed "$ROOT" || die "$ROOT already holds a '$root_fs' filesystem. If you are sure it can be erased, re-run with LFS_CONFIRM_FORMAT=$ROOT"
  fi
  MKFS_SWAP=no
  if [[ -n "$SWAP" ]]; then
    swap_fs=$(blkid -p -s TYPE -o value "$SWAP" 2>/dev/null || true)
    MKFS_SWAP=yes
    if [[ -n "$swap_fs" && "$swap_fs" != swap ]]; then
      confirmed "$SWAP" || die "$SWAP already holds a '$swap_fs' filesystem. If you are sure it can be erased, add it to LFS_CONFIRM_FORMAT"
    fi
  fi

  echo
  echo "  LFS root : $ROOT ($(lsblk -dno SIZE "$ROOT"))  $([[ $MKFS_ROOT == yes ]] && echo 'will be formatted ext4' || echo 'kept as is')"
  echo "  ESP      : $EFI  (shared with Gentoo, not formatted)"
  echo "  Swap     : ${SWAP:-/swapfile 4 GiB inside LFS}"
  warn "The partition table is not changed. Ctrl-C to abort. Sleeping 8s..."
  sleep 8

  [[ $MKFS_ROOT == yes ]] && mkfs.ext4 -F -L LFS "$ROOT"
  if [[ -n "$SWAP" && $MKFS_SWAP == yes ]]; then mkswap -L lfs-swap "$SWAP"; fi

  LFS_DISK="/dev/$(lsblk -no PKNAME "$ROOT" | head -1)"
  cat > /var/log/lfs-parts.env << EOF
LFS_DISK=$LFS_DISK
EFI=$EFI
SWAP=$SWAP
ROOT=$ROOT
EOF
  mark_step disk
fi

source /var/log/lfs-parts.env
mkdir -p "$LFS"
mountpoint -q "$LFS" || mount "$ROOT" "$LFS"
mkdir -p "$LFS/boot/efi"
mountpoint -q "$LFS/boot/efi" || mount "$EFI" "$LFS/boot/efi"
if [[ -n "${SWAP:-}" ]] && ! grep -q "^$(readlink -f "$SWAP")[[:space:]]" /proc/swaps; then swapon "$SWAP" || warn "swapon $SWAP failed (already active?) — continuing"; fi

