-- ~/.config/xmobar/xmobarrc — legenddots · Tokyo Night
-- Fed by XMonad over the _XMONAD_LOG property (statusBarProp in xmonad.hs),
-- read here by the XMonadLog command and shown via %XMonadLog% in the template.
Config { font            = "JetBrainsMono Nerd Font 10"
       , additionalFonts = []
       , bgColor         = "#1a1b26"
       , fgColor         = "#c0caf5"
       , position        = TopH 26
       , border          = NoBorder
       , alpha           = 255
       , lowerOnStart    = True
       , hideOnStart     = False
       , persistent      = True
       , commands =
           [ Run XMonadLog
           , Run Cpu     [ "-t", "cpu <total>%", "-H", "60", "--high", "#f7768e" ] 20
           , Run Memory  [ "-t", "mem <usedratio>%" ] 20
           , Run Battery [ "-t", "bat <left>%<acstatus>"
                         , "--", "-o", "", "-O", "+", "-i", "=" ] 60
           , Run Date "%a %d %b  %H:%M" "date" 60
           ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = " %XMonadLog% }\
                    \{ <fc=#9ece6a>%cpu%</fc>  <fc=#bb9af7>%memory%</fc>  \
                    \<fc=#e0af68>%battery%</fc>  <fc=#7aa2f7>%date%</fc> "
       }
