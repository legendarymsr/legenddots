# 3. Xorg libraries — the BLFS loop: same configure line for all of them
# =============================================================================
if ! step_done xorg_libs; then
  header "Xorg libraries"
  XLIBS=(
    libX11-1.8.10 libXext-1.3.6 libFS-1.0.10 libICE-1.1.2 libSM-1.2.4
    libXScrnSaver-1.2.4 libXt-1.3.1 libXmu-1.2.1 libXpm-3.5.17 libXaw-1.0.16
    libXfixes-6.0.1 libXcomposite-0.4.6 libXrender-0.9.11 libXcursor-1.2.2
    libXdamage-1.1.6 libXi-1.8.2 libXinerama-1.1.5 libXrandr-1.5.4
    libXres-1.2.2 libXtst-1.2.5 libXv-1.0.13 libXxf86vm-1.1.6
    libpciaccess-0.18.1 libxkbfile-1.1.3 libxshmfence-1.3.3
    libXfont2-2.0.7 libxcvt-0.1.3
  )
  for p in "${XLIBS[@]}"; do
    echo "==> $p"
    a=$(xfetch lib "${p}.tar.xz")
    bpkg "$a" bash -c "./configure $XORG_CONFIG; make -j${NPROC}; make install"
  done
  ldconfig
  mark_step xorg_libs
fi

if ! step_done libXft; then
  header "libXft (needs freetype+fontconfig)"
