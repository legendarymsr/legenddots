#!/bin/sh
########################################################################
# Begin network
#
# Description : wlan0 via wpa_supplicant + dhcpcd
#
########################################################################

### BEGIN INIT INFO
# Provides:            $network
# Required-Start:      $local_fs udev
# Should-Start:        $syslog
# Required-Stop:       $local_fs
# Default-Start:       2 3 4 5
# Default-Stop:        0 1 6
# Short-Description:   Starts and configures wifi networking
