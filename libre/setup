# Xorg mirror + a build helper: fetch a package from x.org/pub/individual/<sect>
# and build it with the standard autotools incantation shared by nearly all
# Xorg modules (this is the BLFS "for package" pattern).
XORG_PREFIX=/usr
XORG_CONFIG="--prefix=$XORG_PREFIX --sysconfdir=/etc --localstatedir=/var --disable-static"

xfetch() { fetch "https://www.x.org/pub/individual/$1/$2"; }

xbuild() {  # xbuild <section> <tarball> [extra configure args...]
  local sect="$1" tarball="$2"; shift 2
  local a; a=$(xfetch "$sect" "$tarball")
  bpkg "$a" bash -c "./configure $XORG_CONFIG $*; make -j${NPROC}; make install"
}

# =============================================================================
# 1. Shared graphics foundation (expat, image libs, freetype, fontconfig)
# =============================================================================
if ! step_done expat; then
  header "expat ${EXPAT_VER}"
  a=$(fetch "https://github.com/libexpat/libexpat/releases/download/R_${EXPAT_VER//./_}/expat-${EXPAT_VER}.tar.xz")
  bpkg "$a" bash -c "./configure --prefix=/usr --disable-static; make -j${NPROC}; make install"
  mark_step expat
fi

