# ~/.ratpoisonrc — loaded by guix/home-configuration.scm

# prefix key
escape C-t

# appearance (Tokyo Night)
set border 2
set barinpadding 4
set bargravity NE
set fgcolor #c0caf5
set bgcolor #1a1b26
set selectioncolor #7aa2f7
set font -misc-fixed-medium-r-normal--14-130-75-75-c-70-iso10646-1
set padding 0 0 0 0

# terminal (st)
bind c exec st
bind C-c exec st
bind Return exec st

# launcher (dmenu is themed at build time via suckless/dmenu/config.h)
bind d exec dmenu_run

# apps
bind e exec emacs
bind b exec icecat

# focus
bind h focusleft
bind l focusright
bind k focusup
bind j focusdown
bind n focusnext
bind p focusprev
bind Tab focusnext

# move window
bind H exchangeleft
bind L exchangeright
bind K exchangeup
bind J exchangedown

# workspaces (groups)
bind 1 gselect 1
bind 2 gselect 2
bind 3 gselect 3
bind 4 gselect 4
bind 5 gselect 5
bind 6 gselect 6
bind 7 gselect 7
bind 8 gselect 8
bind 9 gselect 9

# move window to group
bind ! gmove 1
bind @ gmove 2
bind # gmove 3
bind $ gmove 4
bind % gmove 5
bind ^ gmove 6
bind & gmove 7
bind * gmove 8
bind ( gmove 9

# lock screen
bind Escape exec slock

# splits + window management
bind s hsplit
bind S vsplit
bind r remove
bind R ratrestart
bind Q quit
bind q delete
bind C-k kill      # force-kill (K alone is exchangeup, above)

# resize
bind Left resize -w 50
bind Right resize +w 50
bind Up resize -h 50
bind Down resize +h 50

# screenshot
bind Print exec scrot '%Y-%m-%d-%H%M%S.png' -e 'mv $f ~/Pictures/'

# startup
exec xsetroot -solid '#1a1b26'        # fallback fill before the wallpaper loads
exec xwallpaper --zoom ~/.config/wallpapers/guix.jpg
exec emacs --daemon
