if ! step_done free_fonts; then
  header "DejaVu + GNU FreeFont"
  mkdir -pv /usr/share/fonts/dejavu /usr/share/fonts/freefont
  a=$(fetch "https://downloads.sourceforge.net/dejavu/dejavu-fonts-ttf-${DEJAVU_VER}.tar.bz2")
  bpkg "$a" bash -c "cp -v ttf/*.ttf /usr/share/fonts/dejavu/"
  a=$(fetch "https://ftp.gnu.org/gnu/freefont/freefont-ttf-${FREEFONT_VER}.tar.gz")
  bpkg "$a" bash -c "cp -v *.ttf /usr/share/fonts/freefont/ 2>/dev/null || cp -rv . /usr/share/fonts/freefont/"
  fc-cache -f
  mark_step free_fonts
fi

# =============================================================================
# 9. Terminal, WM, editor
# =============================================================================
if ! step_done xterm; then
  header "xterm ${XTERM_VER}"
  a=$(fetch "https://invisible-mirror.net/archives/xterm/xterm-${XTERM_VER}.tgz")
  bpkg "$a" bash -c "
    sed -i '/v0/{n;s/new:/new:kb=^?:/}' termcap
    printf '\tkbs=\\\\177,\\n' >> terminfo
    TERMINFO=/usr/share/terminfo ./configure --prefix=/usr --with-app-defaults=/etc/X11/app-defaults
    make -j${NPROC}; make install
  "
  mark_step xterm
fi
if ! step_done ratpoison; then
  header "ratpoison ${RATPOISON_VER} (GNU window manager)"
  a=$(fetch "https://download.savannah.gnu.org/releases/ratpoison/ratpoison-${RATPOISON_VER}.tar.xz")
  bpkg "$a" bash -c "./configure --prefix=/usr --sysconfdir=/etc; make -j${NPROC}; make install"
  mark_step ratpoison
fi
# xwallpaper (+ its xcb-util deps) so ratpoison can show an image wallpaper.
# All non-fatal: if any fails, libre still works — you just get no wallpaper.
if ! step_done xcb_util; then
  header "xcb-util ${XCB_UTIL_VER}"
  a=$(fetch "https://xorg.freedesktop.org/archive/individual/xcb/xcb-util-${XCB_UTIL_VER}.tar.xz") \
    && bpkg "$a" bash -c "./configure --prefix=/usr; make -j${NPROC}; make install" \
    && mark_step xcb_util || warn "xcb-util failed — wallpaper (xwallpaper) will be skipped"
fi
if ! step_done xcb_util_image; then
  header "xcb-util-image ${XCB_UTIL_IMAGE_VER}"
  a=$(fetch "https://xorg.freedesktop.org/archive/individual/xcb/xcb-util-image-${XCB_UTIL_IMAGE_VER}.tar.xz") \
    && bpkg "$a" bash -c "./configure --prefix=/usr; make -j${NPROC}; make install" \
    && mark_step xcb_util_image || warn "xcb-util-image failed — wallpaper will be skipped"
fi
if ! step_done xwallpaper; then
  header "xwallpaper ${XWALLPAPER_VER} (root-window wallpaper setter)"
  a=$(fetch "https://github.com/stwa/xwallpaper/archive/refs/tags/v${XWALLPAPER_VER}.tar.gz") \
    && bpkg "$a" bash -c "./autogen.sh --prefix=/usr || ./configure --prefix=/usr; make -j${NPROC}; make install" \
    && mark_step xwallpaper || warn "xwallpaper failed — ratpoison will start without a wallpaper"
fi
if ! step_done ncurses_gnutls_dep; then
  header "GnuTLS ${GNUTLS_VER} (for Emacs network security)"
  a=$(fetch "https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-${GNUTLS_VER}.tar.xz")
  bpkg "$a" bash -c "./configure --prefix=/usr --disable-static --without-p11-kit --with-included-libtasn1 --with-included-unistring; make -j${NPROC}; make install" || warn "gnutls failed — Emacs will build without TLS"
  mark_step ncurses_gnutls_dep
fi
if ! step_done emacs; then
  header "GNU Emacs ${EMACS_VER}"
  a=$(fetch "https://ftp.gnu.org/gnu/emacs/emacs-${EMACS_VER}.tar.xz")
  bpkg "$a" bash -c "
    ./configure --prefix=/usr --with-x-toolkit=lucid --with-gif=no \
      --without-selinux --with-modules
    make -j${NPROC}
    make install
  "
  mark_step emacs
fi

# =============================================================================
# 10. Audio (ALSA — fully free)
# =============================================================================
if ! step_done alsa_lib; then
  header "alsa-lib ${ALSA_LIB_VER}"
  a=$(fetch "https://www.alsa-project.org/files/pub/lib/alsa-lib-${ALSA_LIB_VER}.tar.bz2")
  bpkg "$a" bash -c "./configure --prefix=/usr; make -j${NPROC}; make install"
  mark_step alsa_lib
fi
if ! step_done alsa_utils; then
  header "alsa-utils ${ALSA_UTILS_VER}"
  a=$(fetch "https://www.alsa-project.org/files/pub/utils/alsa-utils-${ALSA_UTILS_VER}.tar.bz2")
  bpkg "$a" bash -c "./configure --prefix=/usr --disable-alsaconf --disable-bat --disable-xmlto --with-udev-rules-dir=/usr/lib/udev/rules.d; make -j${NPROC}; make install"
  mark_step alsa_utils
fi

# =============================================================================
# 11. GNU IceCat — the FSF's fully-free Firefox derivative
#     HEAVY: Firefox-class build. Needs a Rust/Node/clang toolchain and, most
#     of all, RAM — linking libxul wants ~8 GB. Guarded so a 4 GB VM doesn't
#     thrash to death; bump the VM to 8 GB (or add swap) to build it.
# =============================================================================
if ! step_done icecat; then
  MEM_GB=$(awk '/MemTotal/{printf "%d", $2/1024/1024}' /proc/meminfo)
  if (( MEM_GB < 7 )); then
    warn "IceCat skipped: only ${MEM_GB} GB RAM detected; the libxul link needs ~8 GB."
    warn "  Give the VM 8 GB (or a big swapfile) and re-run to build IceCat, or"
    warn "  install a lighter libre browser. Marking as skipped so setup continues."
    mark_step icecat
  else
    header "GNU IceCat (Firefox-class build — several hours)"
    warn "IceCat needs a Rust + Node.js + cbindgen + nasm toolchain. Building those"
    warn "from source is itself enormous; see libre/README.md for the toolchain notes."
    ICECAT_VER="115.19.0"
    a=$(fetch "https://ftp.gnu.org/gnu/gnuzilla/${ICECAT_VER}/icecat-${ICECAT_VER}-gnu1.tar.bz2") || \
      { warn "IceCat source fetch failed — see README for mirrors"; a=""; }
    if [[ -n "$a" ]]; then
      bpkg "$a" bash -c "
        cat > .mozconfig << 'MOZ'
ac_add_options --prefix=/usr
ac_add_options --enable-application=browser
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-official-branding
ac_add_options --with-system-zlib
ac_add_options --enable-audio-backends=alsa
ac_add_options --disable-crashreporter
ac_add_options --disable-tests
mk_add_options MOZ_MAKE_FLAGS=-j${NPROC}
MOZ
        ./mach build
        DESTDIR= ./mach install
      " || warn "IceCat build failed (usually toolchain or RAM) — see README"
    fi
    mark_step icecat
  fi
fi

# =============================================================================
# 12. Display manager (xdm) — free, from Xorg
# =============================================================================
if ! step_done xdm; then
  header "xdm ${XDM_VER}"
  xbuild app "xdm-${XDM_VER}.tar.xz" "--with-xdmconfigdir=/etc/X11/xdm" || warn "xdm build failed — you can startx from a getty instead"
  mark_step xdm
fi

# =============================================================================
# 13. User + dotfiles (ratpoison, .xinitrc)
# =============================================================================
if ! step_done user_setup; then
  header "Creating user 'gnu' and desktop config"
  grep -q '^gnu:' /etc/passwd || {
    groupadd -f gnu
    useradd -m -G audio,video,users,gnu -s /bin/bash gnu
    echo 'gnu:libre' | chpasswd
  }

  # Session: startx runs ratpoison. IceCat + xterm launched from ratpoison.
  cat > /home/gnu/.xinitrc << 'EOF'
#!/bin/sh
# Free desktop session: ratpoison window manager.
xrdb -merge ~/.Xresources 2>/dev/null || true
exec ratpoison
EOF

  cat > /home/gnu/.ratpoisonrc << 'EOF'
# GNU ratpoison — keyboard-driven, screen-style prefix is C-t
set border 1
set padding 4 4 4 4
set font "DejaVu Sans Mono:size=11"
set bgcolor black
set fgcolor green
# Launchers
bind c exec xterm
bind e exec emacs
bind b exec icecat
bind w exec ratpoison -c "windows"
escape C-t
# wallpaper (harmless no-op if xwallpaper wasn't built)
exec xwallpaper --zoom ~/.config/wallpapers/libre.jpg
exec xterm
EOF

  cat > /home/gnu/.Xresources << 'EOF'
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11
XTerm*background: black
XTerm*foreground: green
XTerm*saveLines: 10000
EOF

  # Auto-startx on login to tty1 (append to bash profile).
  cat > /home/gnu/.bash_profile << 'EOF'
[ -f ~/.bashrc ] && . ~/.bashrc
# Start the X session automatically on the first console.
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
  exec startx
fi
EOF

  # Wallpaper image for ratpoison's xwallpaper (copied from the repo if present).
  WP_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/wallpapers/libre.jpg"
  mkdir -p /home/gnu/.config/wallpapers
  if [ -f "$WP_SRC" ]; then
    cp "$WP_SRC" /home/gnu/.config/wallpapers/libre.jpg
  else
    warn "wallpaper not found at $WP_SRC — put libre.jpg in ~/.config/wallpapers/ by hand"
  fi

  chown -R gnu:gnu /home/gnu
  mark_step user_setup
fi

echo ""
echo -e "${GREEN}── GNU/Linux-libre desktop complete ──${NC}"
echo "Reboot, log in as 'gnu' (password: libre) on tty1 — X starts automatically"
